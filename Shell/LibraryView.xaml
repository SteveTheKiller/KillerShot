<!-- The library: every capture KillerShot has kept, shown when no image is open and on Ctrl+L.
     Four views (Shelves of cover flows, one big Cover Flow, Grid and Timeline), grouped by
     collection or by date, with search. Rows are built in LibraryView.xaml.cs and virtualized,
     so a library of thousands of captures only ever draws the rows on screen. -->
<UserControl x:Class="KillerShot.Shell.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kc="clr-namespace:KillerShot.Controls"
             xmlns:a11y="clr-namespace:KillerFamily.Accessibility"
             xmlns:local="clr-namespace:KillerShot.Shell">
    <UserControl.Resources>
        <!-- A slim accent slider under each cover flow, in place of the system slider. -->
        <Style x:Key="LibSliderThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="pill" Width="34" Height="8" CornerRadius="4" Background="{DynamicResource SelectionAccent}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pill" Property="Height" Value="10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibSliderTrack" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="2" CornerRadius="1" VerticalAlignment="Center" Background="{DynamicResource CardBorderBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibSlider" TargetType="Slider">
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="5"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource LibSliderTrack}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource LibSliderThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource LibSliderTrack}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Grid and timeline cards use the collection color along their top edge. -->
        <Style x:Key="LibTile" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CaptureCardBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,3,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource CaptureCardTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tile" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource SelectionAccent}"/>
                                <Setter TargetName="tile" Property="RenderTransform"><Setter.Value><TranslateTransform Y="-2"/></Setter.Value></Setter>
                                <Setter TargetName="tile" Property="Effect"><Setter.Value><DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="3" Direction="270" Opacity="{DynamicResource SelectedTileShadowOpacity}"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource SelectionAccent}"/>
                                <Setter TargetName="tile" Property="RenderTransform"><Setter.Value><TranslateTransform Y="-2"/></Setter.Value></Setter>
                                <Setter TargetName="tile" Property="Effect"><Setter.Value><DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="3" Direction="270" Opacity="{DynamicResource SelectedTileShadowOpacity}"/></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The bar: search, a new collection, and the count. The views and grouping are in the
             footer, as KillerPDF's view modes are (FooterView.cs). -->
        <DockPanel x:Name="HeaderBar" Margin="16,12,16,4" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="CountText" Visibility="Collapsed" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,12,4"/>
                <Grid Width="240" Margin="0,0,8,4">
                    <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" FontSize="12" Padding="24,3,6,3"
                             TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                             AutomationProperties.Name="{DynamicResource Str_Lib_Search}"/>
                    <a11y:Glyph Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" IsHitTestVisible="False"
                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock x:Name="SearchHint" Text="{DynamicResource Str_Lib_Search}" IsHitTestVisible="False"
                               Foreground="{DynamicResource DimTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="26,0,0,0"/>
                </Grid>
                <Button x:Name="NewCollectionBtn" Style="{StaticResource SurfaceButton}" Height="26" Padding="10,0"
                        Margin="0,0,0,4" Click="NewCollection_Click" Content="{DynamicResource Str_Lib_NewCollection}"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <!-- Shelves, Grid and Timeline: virtualized rows built in code. -->
            <ItemsControl x:Name="RowsList" Focusable="False"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Standard"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="RowsScroll" Focusable="False" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto" Padding="16,4,8,16">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:LibraryRowHost/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Cover Flow: one big flow across everything shown. -->
            <Grid x:Name="FlowHost" Visibility="Collapsed" Margin="16,4,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <kc:CoverFlow x:Name="BigFlow"/>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,8">
                    <TextBlock x:Name="BigFlowTitle" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource BrandSansFont}"
                               FontSize="17" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="700"/>
                    <TextBlock x:Name="BigFlowDetail" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
                <Slider x:Name="BigFlowSlider" Grid.Row="2" Style="{StaticResource LibSlider}" Minimum="0" MaxWidth="720"
                        Maximum="{Binding MaximumIndex, ElementName=BigFlow}"
                        Value="{Binding SelectedIndex, ElementName=BigFlow, Mode=TwoWay}"
                        Focusable="False" IsTabStop="False"/>
            </Grid>

            <!-- Nothing captured yet, or nothing matches the search. -->
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="EmptyTitle" Foreground="{DynamicResource TextBrush}"
                           FontFamily="{DynamicResource HeadingFont}" FontSize="22" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyHint" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                           Margin="0,8,0,16" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                <Button x:Name="EmptyCaptureBtn" Content="{DynamicResource Str_Btn_CaptureRegion}" Style="{StaticResource OutlineButton}"
                        Padding="14,6" HorizontalAlignment="Center" Click="EmptyCapture_Click"/>
            </StackPanel>

            <!-- The library is locked with a password, or could not be opened. -->
            <StackPanel x:Name="LockPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Width="320" Visibility="Collapsed">
                <a11y:Glyph Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="30" HorizontalAlignment="Center"
                           Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,10"/>
                <TextBlock x:Name="LockTitle" Text="{DynamicResource Str_Lib_LockedTitle}" Foreground="{DynamicResource TextBrush}"
                           FontFamily="{DynamicResource HeadingFont}" FontSize="20" HorizontalAlignment="Center"/>
                <TextBlock x:Name="LockDetail" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,8,0,14"/>
                <PasswordBox x:Name="UnlockBox" KeyDown="UnlockBox_KeyDown" AutomationProperties.Name="{DynamicResource Str_Lib_Password}"
                             Background="{DynamicResource InputFieldBrush}" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}" CaretBrush="{DynamicResource TextBrush}"
                             Padding="6,4" FontSize="13"/>
                <TextBlock x:Name="UnlockError" Foreground="{DynamicResource DangerRed}" FontSize="11" Margin="0,6,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed" Text="{DynamicResource Str_Lib_WrongPassword}"/>
                <Button x:Name="UnlockBtn" Content="{DynamicResource Str_Lib_Unlock}" Style="{StaticResource OutlineButton}"
                        Padding="14,4" Margin="0,12,0,0" HorizontalAlignment="Center" Click="Unlock_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

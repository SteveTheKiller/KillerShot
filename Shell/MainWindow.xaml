<Window x:Class="KillerShot.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:KillerShot.Controls"
        xmlns:editor="clr-namespace:KillerShot.Editor"
        xmlns:local="clr-namespace:KillerShot.Shell"
        xmlns:kl="clr-namespace:KillerFamily.Layout"
        xmlns:theme="clr-namespace:KillerFamily.Theming"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KillerShot"
        Icon="/Resources/kst-icon.ico"
        WindowStyle="None" Background="{DynamicResource BackgroundBrush}"
        MinWidth="640" MinHeight="460" Width="1200" Height="800"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        FontFamily="{DynamicResource UiFont}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="8" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <icons:ScrollEdgeVisibilityConverter x:Key="OverlayScrollEdgeVisibility"/>
        <Style x:Key="OverlayVerticalScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}"/>
        <Style x:Key="OverlayCloseClearScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource OverlayVerticalScrollBar}">
            <!-- The fixed Close hit area ends 32px below the card's top edge. -->
            <Setter Property="Margin" Value="0,32,0,0"/>
        </Style>
        <!-- KillerShell's vertical edge cues, with body spacing inside the viewport. -->
        <Style x:Key="OverlayScrollViewer" TargetType="ScrollViewer">
            <!-- The viewer draws no border of its own; BorderBrush is the top cue's 1px rule, so a
                 host on a gradient surface can give the rule a gradient (the Shortcuts card). -->
            <Setter Property="BorderBrush" Value="{DynamicResource PaneBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <Border Grid.ColumnSpan="2" Height="24" VerticalAlignment="Top" IsHitTestVisible="False"
                                    Opacity="{DynamicResource EdgeFadeOpacity}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#50000000" Offset="0"/>
                                        <GradientStop Color="#22000000" Offset="0.35"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Visibility>
                                    <MultiBinding Converter="{StaticResource OverlayScrollEdgeVisibility}" ConverterParameter="Start">
                                        <Binding Path="VerticalOffset" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ScrollableHeight" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Border.Visibility>
                            </Border>
                            <Border Grid.ColumnSpan="2" Height="28" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                    Opacity="{DynamicResource EdgeFadeOpacity}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#22000000" Offset="0.65"/>
                                        <GradientStop Color="#50000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Visibility>
                                    <MultiBinding Converter="{StaticResource OverlayScrollEdgeVisibility}" ConverterParameter="End">
                                        <Binding Path="VerticalOffset" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ScrollableHeight" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Border.Visibility>
                            </Border>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{DynamicResource OverlayVerticalScrollBar}"
                                       Orientation="Vertical" Cursor="Arrow" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="FrameHost">
    <!-- Opacity 0: Chrome.cs FadeInContent brings RootGrid up on Loaded. -->
    <Grid x:Name="RootGrid" Opacity="0" Margin="{DynamicResource WindowFramePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="{DynamicResource TitleBarGridLength}"/>   <!-- title bar -->
            <RowDefinition Height="*"/>    <!-- toolbar and editor -->
            <RowDefinition Height="24"/>   <!-- footer -->
        </Grid.RowDefinitions>

        <!-- ================= TITLE BAR ================= -->
        <!-- ZIndex 1 so the wordmark's drips can hang into the top of the content row below. -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}" Panel.ZIndex="1">
            <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}">
                <Border.Background>
                    <ImageBrush x:Name="TitleGrainBrush" TileMode="Tile" ViewportUnits="Absolute"
                                Viewport="0,0,256,256" Stretch="None"/>
                </Border.Background>
            </Border>

            <!-- Wordmark: "Killer" in the text color, "Shot" 1.3x in the accent.
                 Blurred dark copy underneath is the soft drop shadow. -->
            <StackPanel x:Name="LogoBar" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="{DynamicResource TitleLogoMargin}" Background="Transparent"
                        Visibility="{DynamicResource WordmarkVisibility}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        PreviewMouseWheel="LogoBar_MouseWheel"
                        MouseLeftButtonDown="LogoBar_MouseLeftButtonDown">
                <icons:AppIcon x:Name="WordmarkTitleIcon"
                       Width="{DynamicResource TitleIconSize}" Height="{DynamicResource TitleIconSize}"
                       Margin="{DynamicResource TitleIconMargin}" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False"/>
                <!-- Negative margins keep Lacquer's deep descent out of the layout so the bar never
                     clips the drips; the 2px imbalance and the lift match KillerPDF. -->
                <Grid Margin="0,-18,0,-22" VerticalAlignment="Center">
                    <Grid.RenderTransform><TranslateTransform Y="-5"/></Grid.RenderTransform>
                    <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"
                               Margin="1,2,0,0" IsHitTestVisible="False"
                               Opacity="{DynamicResource WordmarkShadowOpacity}"><TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect><Run Text="Killer" Foreground="#D8000000"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Shot" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/></TextBlock>
                    <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"
                               Margin="1,2,0,0" IsHitTestVisible="False"
                               Opacity="{DynamicResource WordmarkAccentShadowOpacity}"><TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect><Run Text="Killer" Foreground="Transparent"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Shot" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="Black"/></TextBlock>
                    <TextBlock theme:Bevel.Enabled="True" FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"><Run Text="Killer" Foreground="{DynamicResource TextBrush}"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Shot" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="{DynamicResource AccentLogo}"/></TextBlock>
                </Grid>
                <!-- The open file's name, after the wordmark as KillerPDF shows it. -->
                <TextBlock x:Name="TitleFileLabel" Visibility="Collapsed" IsHitTestVisible="False"
                           Foreground="{DynamicResource FilenameBrush}" FontFamily="{DynamicResource FileNameFont}"
                           FontSize="{DynamicResource FileNameFontSize}" RenderTransform="{DynamicResource FileNameTransform}"
                           TextOptions.TextFormattingMode="Ideal" VerticalAlignment="Center" Margin="16,0,12,0"
                           MaxWidth="420" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{DynamicResource PlainTitleVisibility}"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"
                        Background="Transparent" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        PreviewMouseWheel="LogoBar_MouseWheel" MouseLeftButtonDown="LogoBar_MouseLeftButtonDown">
                <icons:AppIcon x:Name="PlainTitleIcon"
                       Width="{DynamicResource TitleIconSize}" Height="{DynamicResource TitleIconSize}"
                       Margin="{DynamicResource TitleIconMargin}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <TextBlock Text="KillerShot" VerticalAlignment="Center"
                           FontFamily="Microsoft Sans Serif" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource ChromeTextBrush}"/>
                <TextBlock x:Name="PlainTitleFileLabel" Visibility="Collapsed" IsHitTestVisible="False"
                           Foreground="{DynamicResource FilenameBrush}" FontFamily="{DynamicResource FileNameFont}"
                           FontSize="{DynamicResource FileNameFontSize}" RenderTransform="{DynamicResource FileNameTransform}"
                           TextOptions.TextFormattingMode="Ideal" VerticalAlignment="Center" Margin="16,0,12,0"
                           MaxWidth="420" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="{DynamicResource CaptionButtonsMargin}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="ToolbarOverflowButton" Style="{StaticResource ChromeButton}" Content="&#xE712;"
                        Visibility="Collapsed" ToolTip="{DynamicResource Str_CustomizeToolbar_More}"
                        Click="TitleToolbarOverflow_Click"/>
                <!-- The database name shares Notes and Calendar's filename face and size,
                     with no downward shift, aligned to the library icon. -->
                <TextBlock x:Name="TitleLibraryLabel"
                           RenderTransform="{x:Static Transform.Identity}"
                           Foreground="{DynamicResource FilenameBrush}" FontFamily="{DynamicResource FileNameFont}"
                           FontSize="{DynamicResource FileNameFontSize}"
                           TextOptions.TextFormattingMode="Ideal" VerticalAlignment="Center" Margin="12,0,12,0"
                           MaxWidth="240" TextTrimming="CharacterEllipsis" Cursor="Hand"
                           MouseLeftButtonUp="TitleLibraryLabel_Click"/>
                <Button x:Name="LibrarySettingsButton" Click="LibrarySettingsButton_Click"
                        Style="{StaticResource ChromeButton}" FontSize="16" Content="&#xE8F1;"
                        Foreground="{DynamicResource CaptionGlyphBrush}" ToolTip="{DynamicResource Str_Btn_Library}"/>
                <Button x:Name="MinimizeBtn" Click="MinimizeBtn_Click" Style="{StaticResource ChromeButton}"
                        Content="&#xE921;" ToolTip="{DynamicResource Str_Sys_Minimize}"/>
                <Button x:Name="MaximizeBtn" Click="MaximizeBtn_Click" Style="{StaticResource ChromeButton}"
                        Content="&#xE922;" ToolTip="{DynamicResource Str_Sys_Maximize}"/>
                <Button x:Name="CloseBtn" Click="CloseBtn_Click" Style="{StaticResource ChromeCloseButton}"
                        Content="&#xE8BB;" ToolTip="{DynamicResource Str_Sys_Close}"/>
            </StackPanel>

        </Grid>
        <!-- ================= CONTENT ================= -->
        <!-- Chrome tier behind the content row so the side margins carry the grain. -->
        <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}">
            <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}"
                    Background="{DynamicResource GrainTileBrush}"/>
        </Border>

        <Grid x:Name="ScaleHost" Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ToolbarRowDef" Height="Auto" MinHeight="42"/>   <!-- toolbar, on the chrome tier -->
                    <RowDefinition Height="*"/>                     <!-- the lifted editor card -->
                </Grid.RowDefinitions>

                <!-- Right-click anywhere on the bar picks the icon and text style, customizes the bar
                     or hides it (ToolbarStyle.cs). Background must be Transparent, not null, or the
                     menu never opens. The order below is only the default: ApplyToolbarLayout
                     (ToolbarLayout.cs) arranges both sides from the saved layout at startup and after
                     Customize toolbar, and adds the separators, so neither side declares any. -->
                <Grid x:Name="ToolbarGrid" Grid.Row="0" Margin="0,2,18,2" Background="Transparent"
                      MouseLeftButtonDown="Toolbar_MouseDown">
                    <Grid.ContextMenu>
                        <ContextMenu x:Name="ToolbarMenu"/>
                    </Grid.ContextMenu>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>   <!-- left side -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>   <!-- right side -->
                        <ColumnDefinition Width="Auto"/>   <!-- More menu -->
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="LeftBar" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CaptureBtn" Style="{StaticResource ToolbarButton}" Click="CaptureBtn_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="CaptureMenu"/>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="RecordBtn" Style="{StaticResource ToolbarButton}" Click="RecordBtn_Click"/>
                        <Button x:Name="RecentBtn" Style="{StaticResource ToolbarButton}" Click="RecentBtn_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="RecentMenu"/>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="OpenBtn" Style="{StaticResource ToolbarButton}" Click="OpenBtn_Click"/>
                        <Button x:Name="SaveBtn" Style="{StaticResource ToolbarButton}" Click="SaveBtn_Click"/>
                        <Button x:Name="SaveAsBtn" Style="{StaticResource ToolbarButton}" Click="SaveAsBtn_Click"/>
                        <Button x:Name="CopyBtn" Style="{StaticResource ToolbarButton}" Click="CopyBtn_Click"/>
                        <Button x:Name="CopyTextBtn" Style="{StaticResource ToolbarButton}" Click="CopyTextBtn_Click"/>
                        <Button x:Name="PrintBtn" Style="{StaticResource ToolbarButton}" Click="PrintBtn_Click"/>
                        <Button x:Name="UndoBtn" Style="{StaticResource ToolbarButton}" Click="UndoBtn_Click"/>
                        <Button x:Name="RedoBtn" Style="{StaticResource ToolbarButton}" Click="RedoBtn_Click"/>
                        <Button x:Name="ToolSelectBtn" Style="{StaticResource ToolbarButton}" Click="Tool_Click" Tag="Select"/>
                        <Button x:Name="ToolPenBtn" Style="{StaticResource ToolbarButton}" Click="Tool_Click" Tag="Pen"/>
                        <Button x:Name="ToolHighlighterBtn" Style="{StaticResource ToolbarButton}" Click="Tool_Click" Tag="Highlighter"/>
                        <Button x:Name="ToolArrowBtn" Style="{StaticResource ToolbarButton}" Click="Tool_Click" Tag="Arrow"/>
                        <Button x:Name="ToolLineBtn" Style="{StaticResource ToolbarButton}" Click="Tool_Click" Tag="Line"/>
                        <Button x:Name="ToolRectangleBtn" Style="{StaticResource ToolbarButton}" Click="Tool_Click" Tag="Rectangle"/>
                        <Button x:Name="ToolEllipseBtn" Style="{StaticResource ToolbarButton}" Click="Tool_Click" Tag="Ellipse"/>
                        <Button x:Name="FillBtn" Style="{StaticResource ToolbarButton}" Click="FillBtn_Click"/>
                        <Button x:Name="ToolTextBtn" Style="{StaticResource ToolbarButton}" Click="Tool_Click" Tag="Text"/>
                        <Button x:Name="ToolStepBtn" Style="{StaticResource ToolbarButton}" Click="Tool_Click" Tag="Step"/>
                        <Button x:Name="ToolCalloutBtn" Style="{StaticResource ToolbarButton}" Click="Tool_Click" Tag="Callout"/>
                        <Button x:Name="ToolRedactBtn" Style="{StaticResource ToolbarButton}" Click="Tool_Click" Tag="Redact"/>
                        <Button x:Name="ToolCropBtn" Style="{StaticResource ToolbarButton}" Click="Tool_Click" Tag="Crop"/>
                        <Button x:Name="ImageBtn" Style="{StaticResource ToolbarButton}" Click="ImageBtn_Click"/>
                        <Button x:Name="ColorBtn" Style="{StaticResource ToolbarButton}" Click="ColorBtn_Click"/>
                        <Button x:Name="WidthBtn" Style="{StaticResource ToolbarButton}" Click="WidthBtn_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="WidthMenu"/>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="FitBtn" Style="{StaticResource ToolbarButton}" Click="FitBtn_Click"/>
                        <Button x:Name="ActualSizeBtn" Style="{StaticResource ToolbarButton}" Click="ActualSizeBtn_Click"/>
                    </StackPanel>
                    <ContentControl x:Name="ToolbarCollectionHost" Grid.Column="1" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Margin="8,0"/>
                    <StackPanel x:Name="RightBar" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <!-- The More menu: buttons the user put there, and those the window is too narrow
                         for. Shown only when it has something in it. -->
                    <Button x:Name="MoreBtn" Grid.Column="3" Style="{StaticResource ToolbarButton}" Visibility="Collapsed"
                            Width="26" MinWidth="0" Padding="0" VerticalAlignment="Center"
                            Content="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                            Foreground="{DynamicResource MutedTextBrush}"
                            ToolTip="{DynamicResource Str_CustomizeToolbar_More}" Click="MoreBtn_Click"
                            ContextMenuOpening="MoreBtn_ContextMenuOpening">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MoreMenu"/>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <!-- Collections stay beside the workspace; photos sit above or below the editor. -->
                <kl:DockHost x:Name="NavigationDock" Grid.Row="1" Panel.ZIndex="10">
                <kl:DockHost.Body>
                <kl:DockHost x:Name="StripDock">
                <kl:DockHost.Body>
                <Border x:Name="ContentPane"
                        Background="{DynamicResource ContentPaneBrush}" BorderBrush="{DynamicResource PaneBorderBrush}"
                        BorderThickness="{DynamicResource ContentPaneBaseBorderThickness}"
                        CornerRadius="{DynamicResource PanelCornerRadius}" Margin="{DynamicResource ContentPaneMargin}">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="0" Opacity="{DynamicResource PaneShadowOpacity}"/>
                    </Border.Effect>
                    <Grid>
                        <Border x:Name="ContentPaneGrain" IsHitTestVisible="False" Opacity="0.20" Visibility="{DynamicResource FilmGrainVisibility}" Panel.ZIndex="-1" CornerRadius="{DynamicResource PanelCornerRadius}">
                            <Border.Background>
                                <ImageBrush x:Name="GrainBrush" TileMode="Tile" ViewportUnits="Absolute"
                                            Viewport="0,0,256,256" Stretch="None"/>
                            </Border.Background>
                        </Border>

                        <!-- The capture. The canvas sizes itself to the picture at the current zoom;
                             the scroller centers it when it is smaller than the pane. -->
                        <ScrollViewer x:Name="EditorScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      Focusable="False" Margin="1" PreviewMouseWheel="EditorScroll_PreviewMouseWheel"
                                      SizeChanged="EditorScroll_SizeChanged">
                            <Grid x:Name="EditorStage" Background="Transparent" MinWidth="{Binding ViewportWidth, ElementName=EditorScroll}"
                                  MinHeight="{Binding ViewportHeight, ElementName=EditorScroll}">
                                <Border x:Name="EditorFrame" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                        BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="0" Opacity="{DynamicResource PaneShadowOpacity}"/>
                                    </Border.Effect>
                                    <editor:EditorCanvas x:Name="Editor"/>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <!-- The library: every capture kept, shown when no image is open and on Ctrl+L
                             (LibraryView). It also says so when there is no capture yet. -->
                        <local:LibraryView x:Name="Library" Margin="1" Visibility="Collapsed"/>

                        <Border x:Name="ContentPaneOutline" Panel.ZIndex="99" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource PaneBorderBrush}"
                                BorderThickness="{DynamicResource ContentPaneOutlineThickness}"
                                CornerRadius="{DynamicResource PanelCornerRadius}"/>
                        <Border Panel.ZIndex="100" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource PaneBevelDarkBrush}"
                                BorderThickness="{DynamicResource PaneBevelLightThickness}"/>
                        <Border Panel.ZIndex="100" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource PaneBevelLightBrush}"
                                BorderThickness="{DynamicResource PaneBevelDarkThickness}"/>
                        <Border Panel.ZIndex="100" IsHitTestVisible="False"
                                Margin="{DynamicResource PaneBevelInnerMargin}"
                                BorderBrush="{DynamicResource PaneBevelDark2Brush}"
                                BorderThickness="{DynamicResource PaneBevel2LightThickness}"/>
                        <Border Panel.ZIndex="100" IsHitTestVisible="False"
                                Margin="{DynamicResource PaneBevelInnerMargin}"
                                BorderBrush="{DynamicResource PaneBevelLight2Brush}"
                                BorderThickness="{DynamicResource PaneBevel2DarkThickness}"/>
                    </Grid>
                </Border>
                </kl:DockHost.Body>
                </kl:DockHost>
                </kl:DockHost.Body>
                <!-- The icon rail remains beside the collection sidebar. -->
                <kl:DockHost.Rail>
                <StackPanel x:Name="RailStack">
                    <Button x:Name="LibrarySearchButton" Style="{StaticResource RailButton}"
                            Click="LibrarySearchButton_Click" Content="&#xE721;" Margin="0,0,0,6"
                            ToolTip="{DynamicResource Str_Lib_Search}"/>
                    <Button x:Name="NewCollectionButton" Style="{StaticResource RailButton}"
                            Click="NewCollectionButton_Click" Content="&#xE8F4;" Margin="0,0,0,6"
                            ToolTip="{DynamicResource Str_Lib_NewCollection}"/>
                    <Button x:Name="CaptureSettingsButton" Style="{StaticResource RailButton}"
                            Click="CaptureSettingsButton_Click" Content="&#xE713;" Margin="0,0,0,6"
                            ToolTip="{DynamicResource Str_TT_CaptureSettings}"/>
                    <Button x:Name="VideoSettingsButton" Style="{StaticResource RailButton}"
                            Click="VideoSettingsButton_Click" Content="&#xE714;" Margin="0,0,0,6"
                            ToolTip="{DynamicResource Str_TT_VideoSettings}"/>
                    <Button x:Name="QrReadingButton" Style="{StaticResource RailButton}"
                            Click="QrReadingButton_Click" Content="&#xED14;" Margin="0,0,0,6"
                            ToolTip="{DynamicResource Str_TT_QrReading}"/>
                    <!-- Shortcuts: a literal ? in Consolas at 18, the family's rail standard. -->
                    <Button x:Name="ShortcutsButton" Style="{StaticResource RailButton}"
                            Click="ShortcutsButton_Click" Content="?" FontFamily="Consolas"
                            FontSize="18" Margin="0,0,0,6"
                            ToolTip="{DynamicResource Str_TT_Shortcuts}"/>
                    <Button x:Name="LangButton" Style="{StaticResource RailButton}"
                            Click="LangButton_Click" Content="&#xF2B7;" Margin="0,0,0,6"
                            ToolTip="{DynamicResource Str_TT_Language}">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="LangMenu"/>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="ThemeButton" Style="{StaticResource RailButton}"
                            Click="ThemeButton_Click" Content="&#xE790;"
                            ToolTip="{DynamicResource Str_TT_Theme}">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ThemeMenu">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="StaysOpenOnClick" Value="True"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <ContentPresenter ContentSource="Header"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                </kl:DockHost.Rail>
                </kl:DockHost>
            </Grid>

        </Grid>


        <!-- ================= FOOTER (24px) =================
             Panel.ZIndex -1 so the editor card's downward shadow lands on the footer.
             The overlays are declared after this and stay on top. -->
        <Border x:Name="FooterBar" Grid.Row="2" Panel.ZIndex="-1" Background="{DynamicResource FooterBackgroundBrush}">
            <!-- KillerPDF's footer button styles, with the theme accent for hover and the checked
                 underline. FooterView.cs fills and syncs the view cell. -->
            <Border.Resources>
                <Style x:Key="FooterNavButton" TargetType="Button">
                    <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"/>
                    <Setter Property="Width" Value="24"/>
                    <Setter Property="Height" Value="20"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextFooter}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="FooterModeButton" TargetType="RadioButton">
                    <Setter Property="Width" Value="25"/>
                    <Setter Property="Height" Value="20"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextFooter}"/>
                    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Margin="0,3,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SelectionAccent}"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SelectionAccent}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="4" IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}">
                    <Border.Background>
                        <ImageBrush x:Name="StatusGrainBrush" TileMode="Tile" ViewportUnits="Absolute"
                                    Viewport="0,0,256,256" Stretch="None"/>
                    </Border.Background>
                </Border>

                <Grid x:Name="FooterStatusCell" Grid.Column="0" Margin="{DynamicResource FooterCellMargin}"
                      HorizontalAlignment="Left" ClipToBounds="True">
                    <DockPanel LastChildFill="True">
                    <Button x:Name="CollectionPickerBtn" DockPanel.Dock="Left" Style="{StaticResource FooterNavButton}"
                            Width="Auto" MaxWidth="180" Padding="4,0" Margin="4,0,8,0" FontFamily="{DynamicResource UiFont}" FontSize="11"
                            ToolTip="{DynamicResource Str_Strip_Collection}" Click="CollectionPickerBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CollectionNameText" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="CollectionCountText" DockPanel.Dock="Left" Foreground="{DynamicResource TextFooter}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="StatusText" Text="{DynamicResource Str_Status_Ready}" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFooter}"
                               FontFamily="{DynamicResource BrandSansFont}"
                               FontSize="16" TextOptions.TextFormattingMode="Ideal" VerticalAlignment="Center"
                               Margin="4,0,0,0" Padding="{DynamicResource FooterCellPadding}"/>
                    </DockPanel>
                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource FooterBevelDarkBrush}"
                            BorderThickness="{DynamicResource FooterCellLightThickness}"/>
                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource FooterBevelLightBrush}"
                            BorderThickness="{DynamicResource FooterCellDarkThickness}"/>
                </Grid>

                <!-- Centered when space permits; FooterView keeps the action clear of footer controls. -->
                <Button x:Name="PortableBadge" Grid.ColumnSpan="4" Panel.ZIndex="3" Content="{DynamicResource Str_Portable}"
                        ToolTip="{DynamicResource Str_Btn_Install}" Click="Install_Click"
                        Style="{StaticResource OutlineButton}" FontFamily="{DynamicResource UiFont}" FontSize="10" Padding="8,1"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Button.Resources>
                        <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
                    </Button.Resources>
                </Button>

                <!-- Center: picture size and the pixel under the cursor. -->
                <TextBlock x:Name="ImageInfoText" Grid.Column="1" Foreground="{DynamicResource TextFooter}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                           FontFamily="{DynamicResource BrandSansFont}" FontSize="16"
                           TextOptions.TextFormattingMode="Ideal" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- The view cell, as in KillerPDF: the library's views (F5 to F8) and grouping, and
                     with a picture open the collection strip's button (its side and view, in a
                     flyout) and the zoom. Built and kept in step in FooterView.cs. -->
                <Grid x:Name="FooterViewCell" Grid.Column="2" HorizontalAlignment="Right" Margin="{DynamicResource FooterCellMargin}">
                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource FooterBevelDarkBrush}"
                            BorderThickness="{DynamicResource FooterCellLightThickness}" Panel.ZIndex="2"/>
                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource FooterBevelLightBrush}"
                            BorderThickness="{DynamicResource FooterCellDarkThickness}" Panel.ZIndex="2"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{DynamicResource FooterCellPadding}">
                        <StackPanel x:Name="FooterStripControls" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <StackPanel x:Name="FooterLibraryViews" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,4,0"/>
                        <StackPanel x:Name="FooterZoomControls" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                            <Border Width="1" Height="14" Background="{DynamicResource CardBorderBrush}" Margin="0,0,5,0"/>
                            <Button x:Name="ZoomOutBtn" Content="&#xECC9;" Style="{StaticResource FooterNavButton}"
                                    Click="ZoomOutBtn_Click" ToolTip="{DynamicResource Str_KS_ZoomOut}"/>
                            <Button x:Name="ZoomLevelBtn" Style="{StaticResource FooterNavButton}" Width="Auto" MinWidth="48"
                                    FontFamily="{DynamicResource BrandSansFont}" FontSize="16" Padding="4,0"
                                    TextOptions.TextFormattingMode="Ideal" Click="ZoomLevelBtn_Click"
                                    ToolTip="{DynamicResource Str_TT_ZoomLevel}">
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="ZoomMenu"/>
                                </Button.ContextMenu>
                            </Button>
                            <Button x:Name="ZoomInBtn" Content="&#xECC8;" Style="{StaticResource FooterNavButton}"
                                    Click="ZoomInBtn_Click" ToolTip="{DynamicResource Str_KS_ZoomIn}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid x:Name="FooterBrandingCell" Grid.Column="3" HorizontalAlignment="Right" Margin="{DynamicResource FooterCellMargin}">
                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource FooterBevelDarkBrush}"
                            BorderThickness="{DynamicResource FooterCellLightThickness}"/>
                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource FooterBevelLightBrush}"
                            BorderThickness="{DynamicResource FooterCellDarkThickness}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="{DynamicResource FooterCellPadding}">
                    <!-- FontSize 14.5 in the wordmark face (Killer Sans draws small for its em). The status line on the left stays 11.5. -->
                    <TextBlock x:Name="VersionLabel" Opacity="0.75" Text="v1.0.0"
                               Foreground="{DynamicResource TextFooter}" FontFamily="{DynamicResource BrandSansFont}"
                               FontSize="16" TextOptions.TextFormattingMode="Ideal" VerticalAlignment="Center" Margin="0,0,12,0"
                               Cursor="Hand" ToolTip="{DynamicResource Str_TT_About}"
                               MouseLeftButtonUp="VersionLabel_Click"/>
                    <!-- 20px trailing margin keeps the copyright clear of the corner grip. -->
                    <TextBlock x:Name="FooterCopyright" Opacity="0.75" FontSize="16" TextOptions.TextFormattingMode="Ideal" VerticalAlignment="Center" FontFamily="{DynamicResource BrandSansFont}" Margin="0,0,20,0">
                        <Run Text="&#x00A9; 2026 " Foreground="{DynamicResource TextFooter}"/>
                        <Hyperlink NavigateUri="https://thekiller.net" RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{DynamicResource TextFooter}" TextDecorations="None">
                            <Run Text="Steve the Killer"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Resize grip: six 2x2 dots, always visible. Chrome.cs no-ops the drag when maximized. -->
        <Canvas x:Name="ResizeGripDots" Grid.Row="2" Width="13" Height="13" Panel.ZIndex="50"
                Visibility="{DynamicResource GripDotsVisibility}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"
                Background="Transparent" Cursor="SizeNWSE"
                MouseLeftButtonDown="ResizeGrip_MouseDown">
            <Rectangle Canvas.Left="10" Canvas.Top="2"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
            <Rectangle Canvas.Left="6"  Canvas.Top="6"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
            <Rectangle Canvas.Left="10" Canvas.Top="6"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
            <Rectangle Canvas.Left="2"  Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
            <Rectangle Canvas.Left="6"  Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
            <Rectangle Canvas.Left="10" Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
        </Canvas>
        <Canvas Grid.Row="2" Width="14" Height="14" Panel.ZIndex="51"
                Visibility="{DynamicResource GripLinesVisibility}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"
                Background="Transparent" Cursor="SizeNWSE" MouseLeftButtonDown="ResizeGrip_MouseDown">
            <Line X1="12" Y1="3" X2="3" Y2="12" Stroke="{DynamicResource BevelDarkBrush}"/>
            <Line X1="13" Y1="4" X2="4" Y2="13" Stroke="{DynamicResource BevelLightBrush}"/>
            <Line X1="12" Y1="7" X2="7" Y2="12" Stroke="{DynamicResource BevelDarkBrush}"/>
            <Line X1="13" Y1="8" X2="8" Y2="13" Stroke="{DynamicResource BevelLightBrush}"/>
        </Canvas>

        <!-- ================= CAPTURE SETTINGS OVERLAY =================
             Shortcut recorders and capture options. Same card chrome as About. -->
        <Grid x:Name="CaptureSettingsOverlay" Grid.RowSpan="3" Panel.ZIndex="8800" Visibility="Collapsed"
              Background="#88000000" MouseLeftButtonDown="CaptureSettingsOverlay_Click">
            <Grid.Resources>
                <Style x:Key="CsHeading" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}"/>
                    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
                    <Setter Property="FontSize" Value="10"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                </Style>
                <Style x:Key="CsLabel" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="FontSize" Value="12"/>
                </Style>
                <Style x:Key="CsCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <EventSetter Event="Checked" Handler="CaptureOption_Changed"/>
                    <EventSetter Event="Unchecked" Handler="CaptureOption_Changed"/>
                </Style>
            </Grid.Resources>
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MouseLeftButtonDown="AboutCard_Click">
                <Border Background="{DynamicResource OverlayWindowBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="{DynamicResource AboutShadowOpacity}"/>
                    </Border.Effect>
                </Border>
                <Border Background="{DynamicResource OverlayWindowBrush}" BorderBrush="{DynamicResource OverlayEdgeBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}">
                    <Grid>
                        <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                                Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>

                        <Button Content="&#x2715;" Click="CaptureSettingsClose_Click" Style="{StaticResource OverlayCloseButton}"
                                ToolTip="{DynamicResource Str_Sys_Close}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="28" Height="26" Margin="0,6,6,0" Panel.ZIndex="2"
                                Visibility="{DynamicResource AboutModernCloseVisibility}"/>

                        <Border Height="20" VerticalAlignment="Top" Panel.ZIndex="3"
                                Visibility="{DynamicResource AboutCaptionVisibility}"
                                Background="{DynamicResource DialogTitleBarBrush}">
                            <Grid Margin="4,0,2,0">
                                <TextBlock Text="{DynamicResource Str_CS_Title}" VerticalAlignment="Center"
                                           FontFamily="Tahoma" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource ChromeTextBrush}"/>
                                <Button Content="&#xE8BB;" Click="CaptureSettingsClose_Click"
                                        ToolTip="{DynamicResource Str_Sys_Close}"
                                        Style="{StaticResource ChromeCloseButton}" HorizontalAlignment="Right"
                                        Margin="{DynamicResource AboutCaptionCloseMargin}"/>
                            </Grid>
                        </Border>

                        <!-- Two panels that wrap to one column on a narrow window; the scroller covers
                             a short one. -->
                        <ScrollViewer x:Name="CaptureSettingsScroll" Padding="{DynamicResource AboutBodyMargin}" Style="{StaticResource OverlayScrollViewer}" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ScrollViewer.Resources>
                                <Style x:Key="OverlayVerticalScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource OverlayCloseClearScrollBar}"/>
                            </ScrollViewer.Resources>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_CS_Title}" theme:HeadingAccent.Enabled="True"
                                           FontFamily="{DynamicResource HeadingFont}" FontSize="14" FontWeight="Bold" Margin="0,4,0,12"/>
                                <WrapPanel x:Name="SettingsColumns" Orientation="Horizontal" MaxWidth="900">
                                    <StackPanel Width="420" Margin="0,0,24,0">
                                        <TextBlock Text="{DynamicResource Str_CS_Shortcuts}" Style="{StaticResource CsHeading}"/>
                                        <Grid x:Name="ShortcutRows" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="190"/>
                                            </Grid.ColumnDefinitions>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource Str_CS_RecordHint}" Foreground="{DynamicResource DimTextBrush}"
                                                   FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="ShortcutConflictText" Visibility="Collapsed" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource TextBrush}"><Run x:Name="ShortcutConflictRun"/><Run Text=" "/><Hyperlink Click="PrintScreenSetting_Click" Foreground="{DynamicResource PrimaryBrush}" TextDecorations="None"><Run Text="{DynamicResource Str_CS_OpenWindowsSetting}"/></Hyperlink></TextBlock>

                                        <TextBlock Text="{DynamicResource Str_CS_AfterCapture}" Style="{StaticResource CsHeading}" Margin="0,16,0,6"/>
                                        <CheckBox x:Name="ReviewFirstToggle" Content="{DynamicResource Str_CS_ReviewFirst}" Style="{StaticResource CsCheck}"/>
                                        <TextBlock Text="{DynamicResource Str_CS_ReviewFirstHint}" Foreground="{DynamicResource DimTextBrush}"
                                                   FontSize="10" TextWrapping="Wrap" Margin="24,0,0,6"/>
                                        <CheckBox x:Name="CopyToggle" Content="{DynamicResource Str_CS_Copy}" Style="{StaticResource CsCheck}"/>
                                        <CheckBox x:Name="SaveToFolderToggle" Content="{DynamicResource Str_CS_SaveToFolder}" Style="{StaticResource CsCheck}"/>
                                        <CheckBox x:Name="AskToSaveToggle" Content="{DynamicResource Str_CS_AskToSave}" Style="{StaticResource CsCheck}"/>
                                        <CheckBox x:Name="OpenEditorToggle" Content="{DynamicResource Str_CS_OpenEditor}" Style="{StaticResource CsCheck}"/>
                                        <CheckBox x:Name="CopyPathToggle" Content="{DynamicResource Str_CS_CopyPath}" Style="{StaticResource CsCheck}"/>
                                        <DockPanel>
                                            <Button x:Name="OpenWithAppsBtn" DockPanel.Dock="Right" Content="{DynamicResource Str_CS_ChooseApps}" Style="{StaticResource OutlineButton}"
                                                    Padding="8,2" VerticalAlignment="Top" Click="OpenWithApps_Click"/>
                                            <CheckBox x:Name="OpenWithToggle" Content="{DynamicResource Str_CS_OpenWith}" Style="{StaticResource CsCheck}"/>
                                        </DockPanel>
                                        <CheckBox x:Name="EmailToggle" Content="{DynamicResource Str_CS_Email}" Style="{StaticResource CsCheck}"/>
                                        <CheckBox x:Name="NotifyToggle" Content="{DynamicResource Str_CS_Notify}" Style="{StaticResource CsCheck}"/>

                                        <TextBlock Text="{DynamicResource Str_CS_Printing}" Style="{StaticResource CsHeading}" Margin="0,16,0,6"/>
                                        <CheckBox x:Name="PrintShrinkToggle" Content="{DynamicResource Str_CS_PrintShrink}" Style="{StaticResource CsCheck}"/>
                                        <CheckBox x:Name="PrintEnlargeToggle" Content="{DynamicResource Str_CS_PrintEnlarge}" Style="{StaticResource CsCheck}"/>
                                        <CheckBox x:Name="PrintRotateToggle" Content="{DynamicResource Str_CS_PrintRotate}" Style="{StaticResource CsCheck}"/>
                                    </StackPanel>

                                    <StackPanel Width="420">
                                        <TextBlock Text="{DynamicResource Str_CS_Output}" Style="{StaticResource CsHeading}"/>
                                        <TextBlock Text="{DynamicResource Str_CS_Folder}" Style="{StaticResource CsLabel}"/>
                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="OutputFolderBox" FontSize="12" LostKeyboardFocus="OutputFolderBox_LostFocus"/>
                                            <Button Grid.Column="1" Content="{DynamicResource Str_CS_Browse}" Style="{StaticResource OutlineButton}"
                                                    Padding="10,3" Margin="6,0,0,0" Click="BrowseFolder_Click"/>
                                            <Button Grid.Column="2" Content="{DynamicResource Str_CS_Default}" Style="{StaticResource OutlineButton}"
                                                    Padding="10,3" Margin="6,0,0,0" Click="DefaultFolder_Click"/>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource Str_CS_FileName}" Style="{StaticResource CsLabel}"/>
                                        <TextBox x:Name="FileNamePatternBox" FontSize="12" Margin="0,2,0,2" TextChanged="FileNamePatternBox_TextChanged"/>
                                        <TextBlock x:Name="FileNamePlaceholdersText" Foreground="{DynamicResource DimTextBrush}" FontSize="10" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="FileNameExampleText" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Str_CS_Format}" Style="{StaticResource CsLabel}"/>
                                                <ComboBox x:Name="FormatCombo" Margin="0,2,0,0" SelectionChanged="CaptureCombo_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource Str_CS_Quality}" Style="{StaticResource CsLabel}"/>
                                                <ComboBox x:Name="QualityCombo" Margin="0,2,0,0" SelectionChanged="CaptureCombo_Changed"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{DynamicResource Str_CS_Capture}" Style="{StaticResource CsHeading}" Margin="0,16,0,6"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Str_CS_Delay}" Style="{StaticResource CsLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <ComboBox x:Name="DelayCombo" Grid.Column="1" SelectionChanged="CaptureCombo_Changed"/>
                                        </Grid>
                                        <CheckBox x:Name="CursorToggle" Content="{DynamicResource Str_CS_Cursor}" Style="{StaticResource CsCheck}"/>
                                        <CheckBox x:Name="SoundToggle" Content="{DynamicResource Str_CS_Sound}" Style="{StaticResource CsCheck}"/>
                                        <CheckBox x:Name="PickWindowToggle" Content="{DynamicResource Str_CS_PickWindow}" Style="{StaticResource CsCheck}"/>

                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <Border Panel.ZIndex="100" IsHitTestVisible="False" BorderBrush="{DynamicResource OverlayBevelOuterLightBrush}" BorderThickness="{DynamicResource OverlayBevelLightThickness}"/>
                <Border Panel.ZIndex="100" IsHitTestVisible="False" BorderBrush="{DynamicResource OverlayBevelOuterDarkBrush}" BorderThickness="{DynamicResource OverlayBevelDarkThickness}"/>
                <Border Panel.ZIndex="100" IsHitTestVisible="False" Margin="{DynamicResource OverlayBevelInnerMargin}" BorderBrush="{DynamicResource OverlayBevelInnerLightBrush}" BorderThickness="{DynamicResource OverlayBevelLightThickness}"/>
                <Border Panel.ZIndex="100" IsHitTestVisible="False" Margin="{DynamicResource OverlayBevelInnerMargin}" BorderBrush="{DynamicResource OverlayBevelInnerDarkBrush}" BorderThickness="{DynamicResource OverlayBevelDarkThickness}"/>
            </Grid>
        </Grid>

        <!-- ================= VIDEO SETTINGS OVERLAY ================= -->
        <Grid x:Name="VideoSettingsOverlay" Grid.RowSpan="3" Panel.ZIndex="8800" Visibility="Collapsed"
              Background="#88000000" MouseLeftButtonDown="VideoSettingsOverlay_Click">
            <Grid.Resources>
                <Style x:Key="VsHeading" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}"/>
                    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
                    <Setter Property="FontSize" Value="10"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                </Style>
                <Style x:Key="VsLabel" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
                <Style x:Key="VsCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <EventSetter Event="Checked" Handler="VideoOption_Changed"/>
                    <EventSetter Event="Unchecked" Handler="VideoOption_Changed"/>
                </Style>
                <Style x:Key="VsCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Setter Property="Margin" Value="0,3,0,3"/>
                    <EventSetter Event="SelectionChanged" Handler="VideoCombo_Changed"/>
                </Style>
            </Grid.Resources>
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MouseLeftButtonDown="AboutCard_Click">
                <Border Background="{DynamicResource OverlayWindowBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="{DynamicResource AboutShadowOpacity}"/>
                    </Border.Effect>
                </Border>
                <Border Background="{DynamicResource OverlayWindowBrush}" BorderBrush="{DynamicResource OverlayEdgeBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}">
                    <Grid>
                        <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                                Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>
                        <Button Content="&#x2715;" Click="VideoSettingsClose_Click" Style="{StaticResource OverlayCloseButton}"
                                ToolTip="{DynamicResource Str_Sys_Close}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="28" Height="26" Margin="0,6,6,0" Panel.ZIndex="2"
                                Visibility="{DynamicResource AboutModernCloseVisibility}"/>
                        <Border Height="20" VerticalAlignment="Top" Panel.ZIndex="3"
                                Visibility="{DynamicResource AboutCaptionVisibility}"
                                Background="{DynamicResource DialogTitleBarBrush}">
                            <Grid Margin="4,0,2,0">
                                <TextBlock Text="{DynamicResource Str_VS_Title}" VerticalAlignment="Center"
                                           FontFamily="Tahoma" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource ChromeTextBrush}"/>
                                <Button Content="&#xE8BB;" Click="VideoSettingsClose_Click"
                                        ToolTip="{DynamicResource Str_Sys_Close}"
                                        Style="{StaticResource ChromeCloseButton}" HorizontalAlignment="Right"
                                        Margin="{DynamicResource AboutCaptionCloseMargin}"/>
                            </Grid>
                        </Border>

                        <ScrollViewer x:Name="VideoSettingsScroll" Padding="{DynamicResource AboutBodyMargin}" Style="{StaticResource OverlayScrollViewer}" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ScrollViewer.Resources>
                                <Style x:Key="OverlayVerticalScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource OverlayCloseClearScrollBar}"/>
                            </ScrollViewer.Resources>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_VS_Title}" theme:HeadingAccent.Enabled="True"
                                           FontFamily="{DynamicResource HeadingFont}" FontSize="14" FontWeight="Bold" Margin="0,4,0,12"/>
                                <WrapPanel Orientation="Horizontal" MaxWidth="900">
                                    <StackPanel Width="420" Margin="0,0,24,0">
                                        <TextBlock Text="{DynamicResource Str_VS_Format}" Style="{StaticResource VsHeading}"/>
                                        <ComboBox x:Name="VideoFormatCombo" Style="{StaticResource VsCombo}"/>

                                        <TextBlock Text="{DynamicResource Str_VS_Mp4}" Style="{StaticResource VsHeading}" Margin="0,16,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="200"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{DynamicResource Str_VS_Fps}" Style="{StaticResource VsLabel}"/>
                                            <ComboBox x:Name="Mp4FpsCombo" Grid.Column="1" Style="{StaticResource VsCombo}"/>
                                            <TextBlock Grid.Row="1" Text="{DynamicResource Str_VS_Quality}" Style="{StaticResource VsLabel}"/>
                                            <ComboBox x:Name="Mp4QualityCombo" Grid.Row="1" Grid.Column="1" Style="{StaticResource VsCombo}"/>
                                            <TextBlock Grid.Row="2" Text="{DynamicResource Str_VS_Sound}" Style="{StaticResource VsLabel}"/>
                                            <ComboBox x:Name="SoundCombo" Grid.Row="2" Grid.Column="1" Style="{StaticResource VsCombo}"/>
                                            <TextBlock Grid.Row="3" Text="{DynamicResource Str_VS_SoundQuality}" Style="{StaticResource VsLabel}"/>
                                            <ComboBox x:Name="AudioKbpsCombo" Grid.Row="3" Grid.Column="1" Style="{StaticResource VsCombo}"/>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource Str_VS_GifNoSound}" Foreground="{DynamicResource DimTextBrush}"
                                                   FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock Text="{DynamicResource Str_VS_Mp4WidthLimit}" Foreground="{DynamicResource DimTextBrush}"
                                                   FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>

                                        <TextBlock Text="{DynamicResource Str_VS_Gif}" Style="{StaticResource VsHeading}" Margin="0,16,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="200"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{DynamicResource Str_VS_Fps}" Style="{StaticResource VsLabel}"/>
                                            <ComboBox x:Name="GifFpsCombo" Grid.Column="1" Style="{StaticResource VsCombo}"/>
                                            <TextBlock Grid.Row="1" Text="{DynamicResource Str_VS_Colors}" Style="{StaticResource VsLabel}"/>
                                            <ComboBox x:Name="GifColorsCombo" Grid.Row="1" Grid.Column="1" Style="{StaticResource VsCombo}"/>
                                            <TextBlock Grid.Row="2" Text="{DynamicResource Str_VS_Size}" Style="{StaticResource VsLabel}"/>
                                            <ComboBox x:Name="GifSizeCombo" Grid.Row="2" Grid.Column="1" Style="{StaticResource VsCombo}"/>
                                        </Grid>
                                        <CheckBox x:Name="GifLoopToggle" Content="{DynamicResource Str_VS_Loop}" Style="{StaticResource VsCheck}" Margin="0,8,0,8"/>
                                    </StackPanel>

                                    <StackPanel Width="420">
                                        <TextBlock Text="{DynamicResource Str_VS_Recording}" Style="{StaticResource VsHeading}"/>
                                        <CheckBox x:Name="VideoCursorToggle" Content="{DynamicResource Str_VS_Cursor}" Style="{StaticResource VsCheck}"/>
                                        <CheckBox x:Name="VideoCountdownToggle" Content="{DynamicResource Str_VS_Countdown}" Style="{StaticResource VsCheck}"/>
                                        <CheckBox x:Name="VideoCopyToggle" Content="{DynamicResource Str_VS_CopyFile}" Style="{StaticResource VsCheck}"/>
                                        <CheckBox x:Name="VideoNotifyToggle" Content="{DynamicResource Str_VS_Notify}" Style="{StaticResource VsCheck}"/>

                                        <TextBlock Text="{DynamicResource Str_VS_Shortcut}" Style="{StaticResource VsHeading}" Margin="0,16,0,6"/>
                                        <Grid x:Name="VideoShortcutRows">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="190"/>
                                            </Grid.ColumnDefinitions>
                                        </Grid>

                                        <TextBlock Text="{DynamicResource Str_CS_Output}" Style="{StaticResource VsHeading}" Margin="0,16,0,6"/>
                                        <TextBlock Text="{DynamicResource Str_CS_Folder}" Style="{StaticResource VsLabel}"/>
                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="VideoFolderBox" FontSize="12" LostKeyboardFocus="VideoFolderBox_LostFocus"/>
                                            <Button Grid.Column="1" Content="{DynamicResource Str_CS_Browse}" Style="{StaticResource OutlineButton}"
                                                    Padding="10,3" Margin="6,0,0,0" Click="VideoBrowseFolder_Click"/>
                                            <Button Grid.Column="2" Content="{DynamicResource Str_CS_Default}" Style="{StaticResource OutlineButton}"
                                                    Padding="10,3" Margin="6,0,0,0" Click="VideoDefaultFolder_Click"/>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource Str_CS_FileName}" Style="{StaticResource VsLabel}"/>
                                        <TextBox x:Name="VideoFileNameBox" FontSize="12" Margin="0,2,0,2" TextChanged="VideoFileNameBox_TextChanged"/>
                                        <TextBlock x:Name="VideoFileNameExampleText" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <Border Panel.ZIndex="100" IsHitTestVisible="False" BorderBrush="{DynamicResource OverlayBevelOuterLightBrush}" BorderThickness="{DynamicResource OverlayBevelLightThickness}"/>
                <Border Panel.ZIndex="100" IsHitTestVisible="False" BorderBrush="{DynamicResource OverlayBevelOuterDarkBrush}" BorderThickness="{DynamicResource OverlayBevelDarkThickness}"/>
                <Border Panel.ZIndex="100" IsHitTestVisible="False" Margin="{DynamicResource OverlayBevelInnerMargin}" BorderBrush="{DynamicResource OverlayBevelInnerLightBrush}" BorderThickness="{DynamicResource OverlayBevelLightThickness}"/>
                <Border Panel.ZIndex="100" IsHitTestVisible="False" Margin="{DynamicResource OverlayBevelInnerMargin}" BorderBrush="{DynamicResource OverlayBevelInnerDarkBrush}" BorderThickness="{DynamicResource OverlayBevelDarkThickness}"/>
            </Grid>
        </Grid>

        <!-- ================= SHORTCUTS OVERLAY (F1) =================
             Declared BEFORE AboutOverlay so About still wins the z-order tie, the same reason the
             footer sits at ZIndex -1. Both views are generated in Shell/ShortcutsOverlay.cs from
             one binding table; the hosts below are just empty shells. -->
        <Grid x:Name="ShortcutsOverlay" Grid.RowSpan="3" Panel.ZIndex="8900" Visibility="Collapsed"
              Background="#88000000" MouseLeftButtonDown="ShortcutsOverlay_Click">
            <Grid.Resources>
                <!-- Segmented toggle: accent outline at rest, filled when Tag="on". Same rule as
                     the rail's toggles, so "this one is active" reads identically everywhere. -->
                <Style x:Key="KsToggle" TargetType="Button">
                    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="10,3"/>
                    <Setter Property="Margin" Value="0,0,6,0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="Tag" Value="on">
                                        <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <!-- Stretch with a margin, NOT Center, and capped by MaxWidth. Centered, the card sized
                 itself to the keyboard map's natural width and the window simply clipped whatever
                 did not fit - the right-hand keys were cut off on a narrow window. Stretched, the
                 card is at most MaxWidth on a wide window (so it stays a card, not a full-width
                 band) and shrinks with the window below that, which is what gives the Viewbox
                 inside something smaller to scale the keyboard into. (2026-07-30) -->
            <Grid x:Name="ShortcutCardGrid"
                  VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="24"
                  MaxHeight="620"
                  MouseLeftButtonDown="ShortcutsCard_Click">
                <Border Background="{DynamicResource OverlayWindowBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="{DynamicResource ShortcutShadowOpacity}"/>
                    </Border.Effect>
                </Border>
                <Border Background="{DynamicResource OverlayWindowBrush}" BorderBrush="{DynamicResource OverlayEdgeBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}">
                    <Grid>
                        <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                                Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>

                        <Button Content="&#x2715;" Click="ShortcutsClose_Click" Style="{StaticResource OverlayCloseButton}"
                                ToolTip="{DynamicResource Str_Sys_Close}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="28" Height="26" Margin="0,6,6,0" Panel.ZIndex="2"
                                Visibility="{DynamicResource ShortcutModernHeaderVisibility}"/>

                        <Border Height="20" VerticalAlignment="Top" Panel.ZIndex="3"
                                Visibility="{DynamicResource ShortcutCaptionVisibility}"
                                Background="{DynamicResource DialogTitleBarBrush}">
                            <Grid Margin="4,0,2,0">
                                <TextBlock Text="Keyboard shortcuts" VerticalAlignment="Center"
                                           FontFamily="Tahoma" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource ChromeTextBrush}"/>
                                <Button Content="&#xE8BB;" Click="ShortcutsClose_Click"
                                        ToolTip="{DynamicResource Str_Sys_Close}"
                                        Style="{StaticResource ChromeCloseButton}" HorizontalAlignment="Right"
                                        Margin="{DynamicResource DialogCaptionCloseMargin}"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="24,0,24,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str_KS_Title}" theme:HeadingAccent.Enabled="True"
                                           FontFamily="{DynamicResource HeadingFont}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
                                    <Button x:Name="KsViewList" Style="{StaticResource KsToggle}" Tag="on"
                                            Content="{DynamicResource Str_KS_ViewList}" Click="KsViewList_Click"/>
                                    <Button x:Name="KsViewKeyboard" Style="{StaticResource KsToggle}"
                                            Content="{DynamicResource Str_KS_ViewMap}" Click="KsViewKeyboard_Click"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" FontSize="11" MaxWidth="210" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,24,0">
                                    <Hyperlink NavigateUri="https://killershot.net/technical.html#keyboard" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource PrimaryBrush}" TextDecorations="None"><Run Text="{DynamicResource Str_KS_OnlineHelp}"/></Hyperlink>
                                </TextBlock>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,0,24,12">
                                <TextBlock Text="{DynamicResource Str_KS_Hint}" Foreground="{DynamicResource DimTextBrush}"
                                           FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>

                            <!-- LIST -->
                            <ScrollViewer x:Name="KsListHostScroll" Grid.Row="2" Padding="24,0,24,18" Style="{StaticResource OverlayScrollViewer}" BorderBrush="{DynamicResource OverlayRuleBrush}" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Focusable="False">
                                <StackPanel x:Name="KsListHost"/>
                            </ScrollViewer>

                            <!-- MAP -->
                            <Grid x:Name="KsMapHost" Grid.Row="2" Margin="24,0,24,18" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="KsLayerBase" Style="{StaticResource KsToggle}" Tag="on"
                                            Content="BASE" Click="KsLayerBase_Click"/>
                                    <Button x:Name="KsLayerCtrl" Style="{StaticResource KsToggle}"
                                            Content="CTRL" Click="KsLayerCtrl_Click"/>
                                    <Button x:Name="KsLayerAlt" Style="{StaticResource KsToggle}"
                                            Content="ALT" Click="KsLayerAlt_Click"/>
                                    <Button x:Name="KsLayerCtrlShift" Style="{StaticResource KsToggle}"
                                            Content="CTRL+SHIFT" Click="KsLayerCtrlShift_Click"/>
                                </StackPanel>
                                <!-- The keyboard map is drawn at a FIXED unit size (KbUnit), so a
                                     full row is wider than a narrow window and the right-hand keys
                                     were simply cut off. A Viewbox scales the whole map down to
                                     whatever width is going.

                                     StretchDirection DownOnly: it may shrink to fit, never blow up
                                     to fill a wide window - a keyboard rendered at 200% would look
                                     absurd and the caps carry text sized for the natural scale.
                                     Uniform, so the keys keep their proportions. (2026-07-30) -->
                                <!-- Centered DownOnly Viewbox, the same wrapper KillerPDF puts round
                                     its board: it may shrink to fit a narrow window but never blows
                                     up on a wide one, where the card's MaxWidth holds it instead. -->
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                                         Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel x:Name="KsMapRows"/>
                                </Viewbox>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
                <Border Panel.ZIndex="100" IsHitTestVisible="False" BorderBrush="{DynamicResource OverlayBevelOuterLightBrush}" BorderThickness="{DynamicResource OverlayBevelLightThickness}"/>
                <Border Panel.ZIndex="100" IsHitTestVisible="False" BorderBrush="{DynamicResource OverlayBevelOuterDarkBrush}" BorderThickness="{DynamicResource OverlayBevelDarkThickness}"/>
                <Border Panel.ZIndex="100" IsHitTestVisible="False" Margin="{DynamicResource OverlayBevelInnerMargin}" BorderBrush="{DynamicResource OverlayBevelInnerLightBrush}" BorderThickness="{DynamicResource OverlayBevelLightThickness}"/>
                <Border Panel.ZIndex="100" IsHitTestVisible="False" Margin="{DynamicResource OverlayBevelInnerMargin}" BorderBrush="{DynamicResource OverlayBevelInnerDarkBrush}" BorderThickness="{DynamicResource OverlayBevelDarkThickness}"/>
            </Grid>
        </Grid>

        <!-- ================= ABOUT OVERLAY (F12) ================= -->
        <Grid x:Name="AboutOverlay" Grid.RowSpan="3" Panel.ZIndex="9000" Visibility="Collapsed"
              Background="#88000000" MouseLeftButtonDown="AboutOverlay_Click">
            <!-- No fixed width: the SHA-256 line never wraps, so it sizes the info panel and the
                 info panel sizes the card. The header pins its width to that panel. -->
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MouseLeftButtonDown="AboutCard_Click">
                <Border Background="{DynamicResource OverlayWindowBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="{DynamicResource AboutShadowOpacity}"/>
                    </Border.Effect>
                </Border>
                <Border Background="{DynamicResource OverlayWindowBrush}" BorderBrush="{DynamicResource OverlayEdgeBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}">
                    <Grid>
                        <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                                Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>

                        <Button Content="&#x2715;" Click="AboutClose_Click" Style="{StaticResource OverlayCloseButton}"
                                ToolTip="{DynamicResource Str_Sys_Close}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="28" Height="26" Margin="0,6,6,0" Panel.ZIndex="2"
                                Visibility="{DynamicResource AboutModernCloseVisibility}"/>

                        <Border Height="20" VerticalAlignment="Top" Panel.ZIndex="3"
                                Visibility="{DynamicResource AboutCaptionVisibility}"
                                Background="{DynamicResource DialogTitleBarBrush}">
                            <Grid Margin="4,0,2,0">
                                <TextBlock Text="About" VerticalAlignment="Center"
                                           FontFamily="Tahoma" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource ChromeTextBrush}"/>
                                <Button Content="&#xE8BB;" Click="AboutClose_Click"
                                        ToolTip="{DynamicResource Str_Sys_Close}"
                                        Style="{StaticResource ChromeCloseButton}" HorizontalAlignment="Right"
                                        Margin="{DynamicResource AboutCaptionCloseMargin}"/>
                            </Grid>
                        </Border>

                        <StackPanel Margin="{DynamicResource AboutBodyMargin}">
                            <!-- Header: icon left of the wordmark, width pinned to the info panel so a
                                 long tagline wraps instead of widening the card. -->
                            <Grid Margin="0,4,0,14" Width="{Binding ActualWidth, ElementName=AboutInfoGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <icons:AppIcon Grid.Column="0" Source="pack://application:,,,/Resources/kst-icon.ico"
                                       Width="58" Height="58" Margin="0,0,15,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    <icons:AppIcon.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="{DynamicResource IconShadowOpacity}"/>
                                    </icons:AppIcon.Effect>
                                </icons:AppIcon>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid Margin="0,0,0,4" HorizontalAlignment="Left">
                                        <TextBlock FontFamily="{DynamicResource WordmarkFont}" Margin="1,2,0,0" IsHitTestVisible="False"
                                                   Opacity="{DynamicResource WordmarkShadowOpacity}"><TextBlock.Effect><BlurEffect Radius="2"/></TextBlock.Effect><Run Text="Killer" FontSize="17.21" Foreground="#C0000000"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Shot" FontSize="25.85" Foreground="#C0000000"/></TextBlock>
                                        <TextBlock FontFamily="{DynamicResource WordmarkFont}" Margin="1,2,0,0" IsHitTestVisible="False"
                                                   Opacity="{DynamicResource WordmarkAccentShadowOpacity}"><TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect><Run Text="Killer" FontSize="17.21" Foreground="Transparent"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Shot" FontSize="25.85" Foreground="Black"/></TextBlock>
                                        <TextBlock theme:Bevel.Enabled="True" FontFamily="{DynamicResource WordmarkFont}"><Run Text="Killer" FontSize="17.21" Foreground="{DynamicResource TextBrush}"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Shot" FontSize="25.85" Foreground="{DynamicResource AccentLogo}"/></TextBlock>
                                    </Grid>
                                    <!-- Tagline split so GPLv3 and the Killer Tools link stay out of
                                         translation. -->
                                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"><Run Text="{DynamicResource Str_About_DescA}"/><Hyperlink NavigateUri="https://killertools.net" RequestNavigate="AboutLink_Navigate" Foreground="{DynamicResource PrimaryBrush}" TextDecorations="None">Killer Tools</Hyperlink><Run Text="{DynamicResource Str_About_DescB}"/></TextBlock>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="AboutInfoGrid">
                                <Border Background="{DynamicResource AboutPanelBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="{DynamicResource FlyoutShadowOpacity}"/>
                                    </Border.Effect>
                                </Border>
                                <Border Background="{DynamicResource AboutPanelBrush}"
                                        BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <Grid>
                                        <!-- The pane owns an opaque surface brush, so it must own
                                             its grain too; the card grain underneath cannot show
                                             through an opaque child. -->
                                        <Border IsHitTestVisible="False"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Background="{DynamicResource GrainTileBrush}"
                                                Opacity="{DynamicResource GrainOpacity}"/>
                                    <StackPanel Margin="14,12,14,4">
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Version}" Foreground="{DynamicResource DimTextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="10"/>
                                            <Grid Margin="0,1,0,0">
                                                <TextBlock x:Name="AboutVersionBlock" Foreground="{DynamicResource PrimaryBrush}"
                                                           FontFamily="{DynamicResource UiFont}" FontSize="13" Cursor="Hand"
                                                           HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                           MouseLeftButtonUp="AboutVersion_Click"/>
                                                <TextBlock x:Name="AboutReleaseDateBlock" Foreground="{DynamicResource MutedTextBrush}"
                                                           FontFamily="{DynamicResource UiFont}" FontSize="11" FontStyle="Italic"
                                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Publisher}" Foreground="{DynamicResource DimTextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="10"/>
                                            <TextBlock x:Name="AboutPublisherBlock" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,1,0,0"/>
                                            <TextBlock x:Name="AboutAkaBlock" Visibility="Collapsed" Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="11" Margin="0,3,0,0"><Run Text="AKA "/><Hyperlink NavigateUri="https://thekiller.net" RequestNavigate="AboutLink_Navigate" Foreground="{DynamicResource PrimaryBrush}" TextDecorations="None" ToolTip="thekiller.net"><Run x:Name="AboutAkaRun"/></Hyperlink></TextBlock>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Thumbprint}" Foreground="{DynamicResource DimTextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="10"/>
                                            <TextBlock x:Name="AboutThumbprintBlock" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Sha}" Foreground="{DynamicResource DimTextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="10"/>
                                            <TextBlock x:Name="AboutSha256Block" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="11" TextWrapping="NoWrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Panel.ZIndex="20" IsHitTestVisible="False" BorderBrush="{DynamicResource PaneBevelDarkBrush}" BorderThickness="{DynamicResource PaneBevelLightThickness}"/>
                                <Border Panel.ZIndex="20" IsHitTestVisible="False" BorderBrush="{DynamicResource PaneBevelLightBrush}" BorderThickness="{DynamicResource PaneBevelDarkThickness}"/>
                                <Border Panel.ZIndex="20" IsHitTestVisible="False" Margin="{DynamicResource PaneBevelInnerMargin}" BorderBrush="{DynamicResource PaneBevelDark2Brush}" BorderThickness="{DynamicResource PaneBevel2LightThickness}"/>
                                <Border Panel.ZIndex="20" IsHitTestVisible="False" Margin="{DynamicResource PaneBevelInnerMargin}" BorderBrush="{DynamicResource PaneBevelLight2Brush}" BorderThickness="{DynamicResource PaneBevel2DarkThickness}"/>
                            </Grid>

                            <!-- About options belong below the raised identity pane, matching the
                                 shared KillerPDF/Killer Tools About hierarchy. -->
                            <Grid Margin="0,12,0,0" Width="{Binding ActualWidth, ElementName=AboutInfoGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <CheckBox x:Name="AboutStartWithWindows" FontSize="11" Click="AboutStartWithWindows_Click">
                                        <TextBlock Text="{DynamicResource Str_About_StartWithWindows}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <CheckBox x:Name="CloseToTrayCheck" FontSize="11" Margin="0,6,0,0"
                                              Checked="CloseToTray_Changed" Unchecked="CloseToTray_Changed">
                                        <TextBlock Text="{DynamicResource Str_About_CloseToTray}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <TextBlock Text="{DynamicResource Str_About_CloseToTrayHint}"
                                               Foreground="{DynamicResource DimTextBrush}" FontSize="10" Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                <CheckBox x:Name="AboutShowShortcutsInMenus" FontSize="11" Margin="0,0,0,8"
                                          IsChecked="{Binding Source={x:Static kl:ShortcutHints.Current}, Path=Enabled, Mode=TwoWay}">
                                    <TextBlock Text="{DynamicResource Str_About_ShowShortcutsInMenus}" TextWrapping="Wrap"/>
                                </CheckBox>
                                <TextBlock Text="{DynamicResource Str_About_Rendering}" Foreground="{DynamicResource DimTextBrush}"
                                           FontFamily="{DynamicResource UiFont}" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <StackPanel>
                                    <RadioButton x:Name="RenderAutoRadio" Style="{StaticResource ThemeRadio}" GroupName="RenderMode"
                                                 FontSize="11" Margin="8,0,0,0" Checked="RenderMode_Checked" Tag="Auto">
                                        <TextBlock Text="{DynamicResource Str_About_RenderAuto}" TextWrapping="Wrap"/>
                                    </RadioButton>
                                    <RadioButton x:Name="RenderHardwareRadio" Style="{StaticResource ThemeRadio}" GroupName="RenderMode"
                                                 FontSize="11" Margin="8,4,0,0" Checked="RenderMode_Checked" Tag="Hardware">
                                        <TextBlock Text="{DynamicResource Str_About_RenderHardware}" TextWrapping="Wrap"/>
                                    </RadioButton>
                                    <RadioButton x:Name="RenderSoftwareRadio" Style="{StaticResource ThemeRadio}" GroupName="RenderMode"
                                                 FontSize="11" Margin="8,4,0,0" Checked="RenderMode_Checked" Tag="Software">
                                        <TextBlock Text="{DynamicResource Str_About_RenderSoftware}" TextWrapping="Wrap"/>
                                    </RadioButton>
                                </StackPanel>
                                <TextBlock x:Name="RenderHintText" Text="{DynamicResource Str_About_RenderHint}"
                                           Foreground="{DynamicResource DimTextBrush}" FontSize="10" Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </Grid>
                </Border>
                <Border Panel.ZIndex="100" IsHitTestVisible="False" BorderBrush="{DynamicResource OverlayBevelOuterLightBrush}" BorderThickness="{DynamicResource OverlayBevelLightThickness}"/>
                <Border Panel.ZIndex="100" IsHitTestVisible="False" BorderBrush="{DynamicResource OverlayBevelOuterDarkBrush}" BorderThickness="{DynamicResource OverlayBevelDarkThickness}"/>
                <Border Panel.ZIndex="100" IsHitTestVisible="False" Margin="{DynamicResource OverlayBevelInnerMargin}" BorderBrush="{DynamicResource OverlayBevelInnerLightBrush}" BorderThickness="{DynamicResource OverlayBevelLightThickness}"/>
                <Border Panel.ZIndex="100" IsHitTestVisible="False" Margin="{DynamicResource OverlayBevelInnerMargin}" BorderBrush="{DynamicResource OverlayBevelInnerDarkBrush}" BorderThickness="{DynamicResource OverlayBevelDarkThickness}"/>
            </Grid>
        </Grid>
    </Grid>

        <!-- The classic sizing frame is visible only in 98SE; modern palettes reset every brush
             and thickness to transparent/zero in ThemeManager. -->
        <Grid x:Name="ClassicFrameChrome" Panel.ZIndex="9001" IsHitTestVisible="False">
        <Border
                BorderBrush="{DynamicResource FrameOuterLightBrush}"
                BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
        <Border
                BorderBrush="{DynamicResource FrameOuterDarkBrush}"
                BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
        <Border
                Margin="{DynamicResource WindowFrameMargin}"
                BorderBrush="{DynamicResource WindowFrameBrush}"
                BorderThickness="{DynamicResource WindowFrameThickness}"/>
        <Border
                Margin="{DynamicResource FrameInnerMargin}"
                BorderBrush="{DynamicResource FrameInnerLightBrush}"
                BorderThickness="{DynamicResource FrameInnerLightThickness}"/>
        <Border
                Margin="{DynamicResource FrameInnerMargin}"
                BorderBrush="{DynamicResource FrameInnerDarkBrush}"
                BorderThickness="{DynamicResource FrameInnerDarkThickness}"/>
        </Grid>
        <Popup x:Name="LibrarySettingsPopup" PlacementTarget="{Binding ElementName=LibrarySettingsButton}"
               Placement="Bottom" AllowsTransparency="True" StaysOpen="False"
               HorizontalOffset="-16" VerticalOffset="-14" Closed="LibrarySettingsPopup_Closed">
            <Border x:Name="LibrarySettingsCard" Width="460" Style="{StaticResource FlyoutCard}" PreviewKeyDown="LibrarySettingsPopup_PreviewKeyDown">
                <Grid>
                    <ScrollViewer x:Name="LibrarySettingsScroll" Style="{StaticResource OverlayScrollViewer}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14">
                    <StackPanel x:Name="LibrarySettingsContent"
                                TextElement.FontFamily="{DynamicResource UiFont}" TextElement.Foreground="{DynamicResource TextBrush}"
                                KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
                        <TextBlock Text="{DynamicResource Str_Album_Title}" theme:HeadingAccent.Enabled="True" FontFamily="{DynamicResource HeadingFont}"
                                   FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="{DynamicResource Str_Album_New}" Style="{StaticResource OutlineButton}"
                                    Padding="10,4" Margin="0,0,6,4" Click="AlbumNew_Click"/>
                            <Button Content="{DynamicResource Str_Album_OpenFile}" Style="{StaticResource OutlineButton}"
                                    Padding="10,4" Margin="0,0,0,4" Click="AlbumImport_Click"/>
                        </WrapPanel>
                        <ListBox x:Name="AlbumList" MinHeight="80" Margin="0,0,0,10" BorderThickness="1"
                                 Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                 HorizontalContentAlignment="Stretch" SelectionChanged="AlbumList_SelectionChanged"
                                 MouseDoubleClick="AlbumList_DoubleClick" AutomationProperties.Name="{DynamicResource Str_Album_Title}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button x:Name="AlbumOpenBtn" Content="{DynamicResource Str_Lib_Open}" Style="{StaticResource OutlineButton}"
                                    Padding="10,4" Margin="0,0,6,4" Click="AlbumOpen_Click"/>
                            <Button x:Name="AlbumRenameBtn" Content="{DynamicResource Str_Lib_Rename}" Style="{StaticResource OutlineButton}"
                                    Padding="10,4" Margin="0,0,0,4" Click="AlbumRename_Click"/>
                        </WrapPanel>
                        <TextBlock Text="{DynamicResource Str_Album_CopyHint}" FontSize="11" Foreground="{DynamicResource DimTextBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <TextBlock x:Name="ActiveAlbumHeading" theme:HeadingAccent.Enabled="True" FontFamily="{DynamicResource HeadingFont}"
                                   FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LibraryKeepLabel" Text="{DynamicResource Str_CS_Keep}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <DockPanel Grid.Column="1">
                                <Button x:Name="LibraryKeepSaveBtn" DockPanel.Dock="Right" Content="{DynamicResource Str_Lib_Save}"
                                        Style="{StaticResource OutlineButton}" Padding="10,3" Margin="6,0,0,0"
                                        IsEnabled="False" Click="LibraryKeepSave_Click"/>
                                <ComboBox x:Name="LibraryKeepCombo" SelectionChanged="LibraryKeepCombo_Changed"
                                          AutomationProperties.LabeledBy="{Binding ElementName=LibraryKeepLabel}"/>
                            </DockPanel>
                        </Grid>
                        <CheckBox x:Name="LibraryFolderToggle" FontSize="11" Margin="0,0,0,8"
                                  Checked="LibraryFolderToggle_Changed" Unchecked="LibraryFolderToggle_Changed"/>
                        <TextBlock x:Name="LibraryStatusText" Foreground="{DynamicResource DimTextBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <WrapPanel>
                            <Button x:Name="LibraryPasswordBtn" Style="{StaticResource OutlineButton}" Padding="10,3" Click="LibraryPassword_Click"/>
                            <Button x:Name="LibraryRemovePasswordBtn" Content="{DynamicResource Str_CS_RemovePassword}" Style="{StaticResource OutlineButton}"
                                    Padding="10,3" Margin="6,0,0,0" Click="LibraryRemovePassword_Click" Visibility="Collapsed"/>
                        </WrapPanel>
                        <Button x:Name="LibraryReindexBtn" Content="{DynamicResource Str_Ocr_Reindex}" Style="{StaticResource OutlineButton}"
                                HorizontalAlignment="Left" Padding="10,3" Margin="0,8,0,0" Click="LibraryReindex_Click"/>
                    </StackPanel>
                    </ScrollViewer>
                    <Border Style="{StaticResource FlyoutGrain}"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>

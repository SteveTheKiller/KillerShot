<!-- Asked once, after the first recording: plain files in the recording folder, or the
     encrypted library. The frame is ConfirmDialog's (surface, grain, shadow, bevel, wordmark
     caption); only the body differs. -->
<Window x:Class="KillerShot.Controls.RecordingStorageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:KillerFamily.Theming"
        xmlns:local="clr-namespace:KillerShot.Controls"
        Title="KillerShot"
        Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- A choice card: the family radio ring and dot inside a card that takes the accent
             border when picked, so the whole card is the click target. -->
        <Style x:Key="StorageChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="card" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource PanelCornerRadius}" Padding="15,12,15,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <!-- DimTextBrush ring, as the family ThemeRadio draws it: the input
                                     border brush vanished against a card on the dark themes. -->
                                <Border x:Name="ring" Width="15" Height="15" CornerRadius="8"
                                        VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0"
                                        Background="{DynamicResource RadioWellBrush}"
                                        BorderBrush="{DynamicResource DimTextBrush}" BorderThickness="1.5">
                                    <Border x:Name="dot" Width="7" Height="7" CornerRadius="4"
                                            Background="{DynamicResource PrimaryBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Grid.Column="1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/>
                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="card" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="card" Property="Padding" Value="14,11,14,11"/>
                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <local:PickerBorder x:Name="RootBorder" Opacity="0"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="{DynamicResource DialogOuterBorderThickness}"
            CornerRadius="{DynamicResource PanelCornerRadius}"
            Margin="{DynamicResource DialogHaloMargin}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Direction="270"
                              Opacity="{DynamicResource FlyoutShadowOpacity}"/>
        </Border.Effect>
        <Grid>
            <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                    Opacity="{DynamicResource GrainOpacity}"
                    Background="{DynamicResource GrainTileBrush}"/>
            <Border IsHitTestVisible="False" Panel.ZIndex="6"
                    BorderBrush="{DynamicResource FrameOuterLightBrush}" BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
            <Border IsHitTestVisible="False" Panel.ZIndex="6"
                    BorderBrush="{DynamicResource FrameOuterDarkBrush}"  BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
            <Border IsHitTestVisible="False" Panel.ZIndex="6" Margin="{DynamicResource FrameInnerMargin}"
                    BorderBrush="{DynamicResource FrameInnerLightBrush}" BorderThickness="{DynamicResource FrameInnerLightThickness}"/>
            <Border IsHitTestVisible="False" Panel.ZIndex="6" Margin="{DynamicResource FrameInnerMargin}"
                    BorderBrush="{DynamicResource FrameInnerDarkBrush}" BorderThickness="{DynamicResource FrameInnerDarkThickness}"/>

            <Grid Margin="{DynamicResource DialogContentMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{DynamicResource DialogTitleBarRowHeight}"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource DialogTitleBarBrush}"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Panel.ZIndex="1">
                    <Grid Margin="{DynamicResource DialogTitleBarPadding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <local:AppIcon x:Name="TitleIcon" VerticalAlignment="Center"
                                   Width="{DynamicResource TitleIconSize}" Height="{DynamicResource TitleIconSize}"
                                   Margin="{DynamicResource TitleIconMargin}"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <Grid VerticalAlignment="Center" Margin="0,-18,0,-22">
                                <Grid.RenderTransform><TranslateTransform Y="-5"/></Grid.RenderTransform>
                                <StackPanel Orientation="Horizontal" Margin="1,2,0,0"
                                            Visibility="{DynamicResource DialogWordmarkVisibility}"
                                            Opacity="{DynamicResource WordmarkShadowOpacity}">
                                    <StackPanel.Effect><BlurEffect Radius="3"/></StackPanel.Effect>
                                    <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"><Run Text="Killer" Foreground="#D8000000"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Shot" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/></TextBlock>
                                </StackPanel>
                                <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"
                                           Visibility="{DynamicResource DialogWordmarkVisibility}" Margin="1,2,0,0" IsHitTestVisible="False" Opacity="{DynamicResource WordmarkAccentShadowOpacity}"><TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect><Run Text="Killer" Foreground="Transparent"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Shot" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/></TextBlock>
                                <TextBlock theme:Bevel.Enabled="True" FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"
                                           Visibility="{DynamicResource DialogWordmarkVisibility}"><Run Text="Killer" Foreground="{DynamicResource TextBrush}"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Shot" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="{DynamicResource AccentLogo}"/></TextBlock>
                            </Grid>
                            <TextBlock Text="KillerShot" FontFamily="{DynamicResource ChromeFontFamily}" VerticalAlignment="Center"
                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ChromeTextBrush}"
                                       Visibility="{DynamicResource DialogPlainTitleVisibility}"/>
                        </StackPanel>
                        <Button Content="{DynamicResource AboutCloseGlyph}" Click="Close_Click"
                                ToolTip="{DynamicResource Str_Sys_Close}"
                                AutomationProperties.Name="{DynamicResource Str_Sys_Close}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="{DynamicResource AboutCloseWidth}" Height="{DynamicResource AboutCloseHeight}"
                                Style="{StaticResource OverlayCloseButton}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="24,16,24,6">
                    <!-- The clip first, so the dialog opens by saying where it went. -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="PosterFrame" Width="96" Height="56" Margin="0,0,14,0" VerticalAlignment="Center"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource SmallCornerRadius}" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="Poster" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.8"/></TextBlock.Effect>
                                </TextBlock>
                                <Border x:Name="DurationBadge" Background="#B0000000" CornerRadius="2" Padding="4,0,4,1"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3" Visibility="Collapsed">
                                    <TextBlock x:Name="DurationText" Foreground="White" FontSize="10"/>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Str_Rec_FirstTitle}" Foreground="{DynamicResource TextBrush}"
                                       FontFamily="{DynamicResource HeadingFont}" FontSize="18"
                                       TextOptions.TextFormattingMode="Ideal" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource Str_Rec_FirstQuestion}" Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <RadioButton x:Name="FolderChoice" GroupName="Storage" Style="{StaticResource StorageChoice}" IsChecked="True"
                                 AutomationProperties.Name="{DynamicResource Str_Rec_FolderTitle}">
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="SemiBold"><Run Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontWeight="Normal"/><Run Text="  "/><Run Text="{DynamicResource Str_Rec_FolderTitle}"/></TextBlock>
                            <TextBlock x:Name="FolderDetail" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" LineHeight="18"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="LibraryChoice" GroupName="Storage" Style="{StaticResource StorageChoice}"
                                 AutomationProperties.Name="{DynamicResource Str_Rec_LibraryTitle}">
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="SemiBold"><Run Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontWeight="Normal"/><Run Text="  "/><Run Text="{DynamicResource Str_Rec_LibraryTitle}"/></TextBlock>
                            <TextBlock Text="{DynamicResource Str_Rec_LibraryDetail}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" LineHeight="18"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="{DynamicResource Str_Rec_Footnote}" Foreground="{DynamicResource DimTextBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,14,24,20">
                    <Button x:Name="OpenClipButton" Content="{DynamicResource Str_Rec_OpenClip}" Click="OpenClip_Click"
                            Style="{StaticResource SurfaceButton}"
                            Height="28" MinWidth="80" Padding="12,2" Margin="0,0,8,0"/>
                    <Button x:Name="ContinueButton" Content="{DynamicResource Str_Rec_Continue}" Click="Continue_Click" IsDefault="True"
                            Style="{StaticResource OutlineButton}"
                            Height="28" MinWidth="80" Padding="12,2"/>
                </StackPanel>
            </Grid>
        </Grid>
    </local:PickerBorder>
</Window>

<!-- Themed prompt: the confirm dialog's frame around one text box (a name or a note) or
     password boxes (unlock, set and change the library password). Ported from Killendar's
     PasswordDialog, with the text box added. -->
<Window x:Class="KillerShot.Controls.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:KillerShot.Controls"
        xmlns:kui="clr-namespace:KillerShot.Controls"
        Title="KillerShot"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <!-- Margin is a transparent halo so the drop shadow has room to render (AllowsTransparency window,
         so WPF draws the shadow rather than the OS). -->
    <!-- Dialog cards sit on the dark tier. Inputs and DimTextBrush are calibrated against it;
         on SurfaceBrush a field is the same color as the card behind it. -->
    <kui:PickerBorder x:Name="RootBorder" Opacity="0"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource PanelCornerRadius}"
            Margin="{DynamicResource DialogHaloMargin}">
        <kui:PickerBorder.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="{DynamicResource AboutShadowOpacity}"/>
        </kui:PickerBorder.Effect>
        <Grid>
            <!-- Film grain over the whole dialog (behind content), so it reads as one continuous
                 surface like the main window chrome. -->
            <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                    Opacity="{DynamicResource GrainOpacity}"
                    Background="{DynamicResource GrainTileBrush}"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- The title brush has its own grain overlay and follows the card's top corners. -->
                <Border Grid.Row="0" Background="{DynamicResource DialogTitleBarBrush}"
                        Height="{DynamicResource DialogTitleBarHeight}"
                        CornerRadius="{DynamicResource DialogTitleCornerRadius}"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Panel.ZIndex="1">
                    <Grid>
                        <Border IsHitTestVisible="False" CornerRadius="{DynamicResource DialogTitleCornerRadius}"
                                Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="{DynamicResource DialogTitleMargin}">
                        <!-- The app icon leads the caption, as it does in the main title bar. -->
                        <icons:AppIcon x:Name="TitleIcon"
                               Width="{DynamicResource TitleIconSize}" Height="{DynamicResource TitleIconSize}"
                               Margin="{DynamicResource TitleIconMargin}" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <!-- Wordmark with the same soft dark shadow copy the main title bar uses. -->
                        <Grid VerticalAlignment="Center"
                              Visibility="{DynamicResource WordmarkVisibility}" Margin="0,-18,0,-22">
                            <Grid.RenderTransform><TranslateTransform Y="-5"/></Grid.RenderTransform>
                            <StackPanel Orientation="Horizontal" Margin="1,2,0,0"
                                        Opacity="{DynamicResource WordmarkShadowOpacity}">
                                <StackPanel.Effect><BlurEffect Radius="3"/></StackPanel.Effect>
                                <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"><Run Text="Killer" Foreground="#D8000000"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Shot" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/></TextBlock>
                            </StackPanel>
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}" Margin="1,2,0,0" IsHitTestVisible="False" Opacity="{DynamicResource WordmarkAccentShadowOpacity}"><TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect><Run Text="Killer" Foreground="Transparent"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Shot" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/></TextBlock>
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"><Run Text="Killer" Foreground="{DynamicResource TextBrush}"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Shot" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="{DynamicResource AccentLogo}"/></TextBlock>
                        </Grid>
                        <TextBlock Text="KillerShot" Visibility="{DynamicResource PlainTitleVisibility}"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource ChromeFontFamily}" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource ChromeTextBrush}"/>
                        </StackPanel>
                        <!-- Same X as the About card: the family overlay glyph on a card, the classic caption button on 98SE. -->
                        <Button Content="&#xE8BB;" Click="Cancel_Click" Style="{StaticResource ChromeCloseButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="{DynamicResource DialogCaptionCloseMargin}" Visibility="{DynamicResource PlainTitleVisibility}"/>
                        <Button Content="&#x2715;" Click="Cancel_Click" Style="{StaticResource OverlayCloseButton}"
                                ToolTip="{DynamicResource Str_Sys_Close}" AutomationProperties.Name="{DynamicResource Str_Sys_Close}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="26" Margin="0,0,3,0"
                                Visibility="{DynamicResource AboutModernCloseVisibility}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="24,18,24,16">
                    <TextBlock x:Name="HeadingText" Foreground="{StaticResource TextBrush}"
                               FontFamily="{DynamicResource HeadingFont}" FontSize="17"
                               TextOptions.TextFormattingMode="Ideal" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock x:Name="DetailText" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBox x:Name="InputText" Style="{StaticResource DarkTextBox}" FontSize="13" Padding="6,4"
                             KeyDown="Input_KeyDown" Visibility="Collapsed"/>
                    <PasswordBox x:Name="PwBox" KeyDown="Input_KeyDown" Visibility="Collapsed"
                                 Background="{DynamicResource InputFieldBrush}" Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}" CaretBrush="{DynamicResource TextBrush}"
                                 Padding="6,4" FontSize="13"/>
                    <TextBlock x:Name="ConfirmLabel" Text="{DynamicResource Str_Lib_ConfirmPassword}"
                               Foreground="{DynamicResource DimTextBrush}" FontSize="10"
                               Margin="0,8,0,2" Visibility="Collapsed"/>
                    <PasswordBox x:Name="PwConfirmBox" KeyDown="Input_KeyDown" Visibility="Collapsed"
                                 AutomationProperties.Name="{DynamicResource Str_Lib_ConfirmPassword}"
                                 Background="{DynamicResource InputFieldBrush}" Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}" CaretBrush="{DynamicResource TextBrush}"
                                 Padding="6,4" FontSize="13"/>
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerRed}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20">
                    <Button x:Name="CancelButton" Content="{DynamicResource Str_Btn_Cancel}" Click="Cancel_Click" IsCancel="True"
                            Style="{StaticResource SurfaceButton}" Height="28" MinWidth="80" Padding="12,2" Margin="0,0,8,0"/>
                    <Button x:Name="OkButton" Click="OK_Click" Style="{StaticResource OutlineButton}"
                            Height="28" MinWidth="80" Padding="12,2"/>
                </StackPanel>
            </Grid>
            <Border Panel.ZIndex="9000" IsHitTestVisible="False" BorderBrush="{DynamicResource OverlayBevelOuterLightBrush}" BorderThickness="{DynamicResource OverlayBevelLightThickness}"/>
            <Border Panel.ZIndex="9000" IsHitTestVisible="False" BorderBrush="{DynamicResource OverlayBevelOuterDarkBrush}" BorderThickness="{DynamicResource OverlayBevelDarkThickness}"/>
            <Border Panel.ZIndex="9001" IsHitTestVisible="False" Margin="{DynamicResource OverlayBevelInnerMargin}" BorderBrush="{DynamicResource OverlayBevelInnerLightBrush}" BorderThickness="{DynamicResource OverlayBevelLightThickness}"/>
            <Border Panel.ZIndex="9001" IsHitTestVisible="False" Margin="{DynamicResource OverlayBevelInnerMargin}" BorderBrush="{DynamicResource OverlayBevelInnerDarkBrush}" BorderThickness="{DynamicResource OverlayBevelDarkThickness}"/>
        </Grid>
    </kui:PickerBorder>
</Window>

<!-- KillerShot's own theme values: keys only KillerShot's views use. ThemeManager.AppTokens
     (Services/AppTheme.cs) merges the 98SE values over the family palette. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Thickness x:Key="AboutBodyMargin">8,18,8,18</Thickness>
    <Thickness x:Key="AboutCaptionCloseMargin">0,1,1,2</Thickness>
    <Visibility x:Key="AboutCaptionVisibility">Visible</Visibility>
    <Visibility x:Key="AboutModernCloseVisibility">Collapsed</Visibility>
    <sys:Double x:Key="AboutShadowOpacity">0</sys:Double>
    <Visibility x:Key="ShortcutCaptionVisibility">Visible</Visibility>
    <Visibility x:Key="ShortcutModernHeaderVisibility">Collapsed</Visibility>
    <CornerRadius x:Key="DialogTitleCornerRadius">0</CornerRadius>
    <Thickness x:Key="DialogTitleTextMargin">4,0,0,0</Thickness>
    <Thickness x:Key="DialogCaptionCloseMargin">0,2,3,2</Thickness>
    <Thickness x:Key="OverlayBevelLightThickness">1,1,0,0</Thickness>
    <Thickness x:Key="OverlayBevelDarkThickness">0,0,1,1</Thickness>
    <Thickness x:Key="OverlayBevelInnerMargin">1</Thickness>
    <Thickness x:Key="CheckSunkenDarkThickness">1,1,0,0</Thickness>
    <Thickness x:Key="CheckSunkenLightThickness">0,0,1,1</Thickness>
    <Thickness x:Key="ContentPaneOutlineThickness">0</Thickness>
    <GridLength x:Key="TitleBarGridLength">22</GridLength>
    <CornerRadius x:Key="LibrarySliderTrackCornerRadius">0</CornerRadius>
    <sys:Double x:Key="ToolbarWidthBarRadius">0</sys:Double>
    <sys:Double x:Key="SelectedTileShadowOpacity">0</sys:Double>
    <SolidColorBrush x:Key="InputFieldBrush" Color="#ffffff" po:Freeze="True"/>
    <!-- A white client pane, and the file name in light text on the active caption gradient. -->
    <SolidColorBrush x:Key="ContentPaneBrush" Color="#ffffff" po:Freeze="True"/>
    <SolidColorBrush x:Key="FilenameBrush" Color="#e8e8e8" po:Freeze="True"/>
    <Thickness x:Key="ContentPaneMargin">0</Thickness>
    <Thickness x:Key="TitleLogoMargin">4,2,0,0</Thickness>
</ResourceDictionary>

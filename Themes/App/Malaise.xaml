<!-- KillerShot's own theme values: keys only KillerShot's views use. ThemeManager.AppTokens
     (Services/AppTheme.cs) merges the Malaise values over the family palette. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <!-- Malaise content panes are opaque #303638, lighter than the menu surface (theme contract
         rule 16); the family states it as ListPaneBrush, KillerShot's views read ContentPaneBrush. -->
    <SolidColorBrush x:Key="ContentPaneBrush" Color="#303638" po:Freeze="True"/>
</ResourceDictionary>

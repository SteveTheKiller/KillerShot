<!-- KillerShot's own theme values: keys only KillerShot's views use. ThemeManager.AppTokens
     (Services/AppTheme.cs) merges the defaults for every theme over the family palette. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- About and Keyboard Shortcuts: the modern close button and header, not the Win98 caption. -->
    <Thickness x:Key="AboutBodyMargin">8,10,8,18</Thickness>
    <Thickness x:Key="AboutCaptionCloseMargin">0</Thickness>
    <Visibility x:Key="AboutCaptionVisibility">Collapsed</Visibility>
    <Visibility x:Key="AboutModernCloseVisibility">Visible</Visibility>
    <sys:Double x:Key="AboutShadowOpacity">0.6</sys:Double>
    <Visibility x:Key="ShortcutCaptionVisibility">Collapsed</Visibility>
    <Visibility x:Key="ShortcutModernHeaderVisibility">Visible</Visibility>
    <!-- Dialog captions. -->
    <CornerRadius x:Key="DialogTitleCornerRadius">6,6,0,0</CornerRadius>
    <Thickness x:Key="DialogTitleTextMargin">14,0,0,0</Thickness>
    <Thickness x:Key="DialogCaptionCloseMargin">0</Thickness>
    <!-- The 98SE raised frame around About, Shortcuts and the dialogs; none elsewhere. -->
    <Thickness x:Key="OverlayBevelLightThickness">0</Thickness>
    <Thickness x:Key="OverlayBevelDarkThickness">0</Thickness>
    <Thickness x:Key="OverlayBevelInnerMargin">0</Thickness>
    <!-- The 98SE sunken well on password fields; none elsewhere. -->
    <Thickness x:Key="CheckSunkenDarkThickness">0</Thickness>
    <Thickness x:Key="CheckSunkenLightThickness">0</Thickness>
    <!-- The editor's content pane and title row: the pane keeps its 8px gutter on the right,
         and the logo sits 4px off the top-left corner as in KillerPDF. -->
    <Thickness x:Key="ContentPaneMargin">0,0,8,0</Thickness>
    <Thickness x:Key="TitleLogoMargin">4,4,0,0</Thickness>
    <Thickness x:Key="ContentPaneBaseBorderThickness">0</Thickness>
    <Thickness x:Key="ContentPaneOutlineThickness">1</Thickness>
    <GridLength x:Key="TitleBarGridLength">32</GridLength>
    <!-- The album's slider track, the toolbar width bar and the selected tile's shadow. -->
    <CornerRadius x:Key="LibrarySliderTrackCornerRadius">1</CornerRadius>
    <sys:Double x:Key="ToolbarWidthBarRadius">1</sys:Double>
    <sys:Double x:Key="SelectedTileShadowOpacity">0.45</sys:Double>
</ResourceDictionary>

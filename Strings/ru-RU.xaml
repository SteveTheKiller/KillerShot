    <!-- KillerShot -->
    <sys:String x:Key="Str_About_DescA" xml:space="preserve">Инструмент для снимков экрана, который копирует ровно то, что вы выделили, пиксель в пиксель, без учётной записи и без отправки данных куда-либо. Утилита GPLv3 от </sys:String>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Plain net10.0-windows: a Windows SDK version here bundles Microsoft's 25 MB projection of
         the whole Windows Runtime. Window capture, OCR and MP4 recording call Windows through
         their COM interfaces instead (Native/WinRt.cs). app.manifest keeps the Windows 11 minimum. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\kst-icon.ico</ApplicationIcon>
    <Version>1.1.1</Version>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <Authors>Steve the Killer</Authors>
    <Copyright>Copyright (c) 2026 Steve the Killer</Copyright>
    <FileVersion>1.1.1.0</FileVersion>
    <!-- Shown on the About card beside the version. Keep this as Unreleased during development. -->
    <ReleaseDate>2026-10-28</ReleaseDate>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Bake ReleaseDate into the assembly so About can show it. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ReleaseDate</_Parameter1>
      <_Parameter2>$(ReleaseDate)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The command line's commands are compiled into the app, so KillerShot.exe runs them when
       its first argument is the cli switch. The rest of KillerShot.Cli (its console entry and
       build output) belongs to that project. -->
  <ItemGroup>
    <Compile Remove="KillerShot.Cli\**\*.cs" />
    <Compile Include="KillerShot.Cli\Program.cs" />
    <None Remove="KillerShot.Cli\**\*" />
    <EmbeddedResource Remove="KillerShot.Cli\**\*" />
    <Page Remove="KillerShot.Cli\**\*" />
    <!-- The Print Screen helper is its own program (PrintScreenHelper/), built below. -->
    <Compile Remove="PrintScreenHelper\**\*" />
    <None Remove="PrintScreenHelper\**\*" />
    <EmbeddedResource Remove="PrintScreenHelper\**\*" />
    <Page Remove="PrintScreenHelper\**\*" />
  </ItemGroup>

  <!-- KillerShot.PrintScreen.exe rides inside KillerShot.exe as a resource and is put in Program
       Files\KillerShot when wanted (Services/PrintScreenHelper.cs). A normal build publishes it
       first. release.ps1 publishes and signs it itself and passes PrintScreenHelperPrebuilt=true,
       so the signed file is the one embedded: UI Access needs the helper's own signature. -->
  <PropertyGroup>
    <PrintScreenHelperDir>$(MSBuildThisFileDirectory)bin\PrintScreenHelper\</PrintScreenHelperDir>
    <PrintScreenHelperExe>$(PrintScreenHelperDir)KillerShot.PrintScreen.exe</PrintScreenHelperExe>
  </PropertyGroup>
  <Target Name="EmbedPrintScreenHelper" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_PrintScreenHelperProperties>Configuration=Release;PublishDir=$(PrintScreenHelperDir);Version=$(Version);FileVersion=$(FileVersion);AssemblyVersion=$(AssemblyVersion)</_PrintScreenHelperProperties>
    </PropertyGroup>
    <MSBuild Condition="'$(PrintScreenHelperPrebuilt)' != 'true'" Projects="PrintScreenHelper\KillerShot.PrintScreen.csproj"
             Targets="Restore" Properties="$(_PrintScreenHelperProperties);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Condition="'$(PrintScreenHelperPrebuilt)' != 'true'" Projects="PrintScreenHelper\KillerShot.PrintScreen.csproj"
             Targets="Publish" Properties="$(_PrintScreenHelperProperties)" />
    <Error Condition="!Exists('$(PrintScreenHelperExe)')" Text="The Print Screen helper is missing: $(PrintScreenHelperExe)" />
    <ItemGroup>
      <EmbeddedResource Include="$(PrintScreenHelperExe)" LogicalName="KillerShot.PrintScreen.exe" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- The capture library: SQLite, encrypted at rest with SQLCipher (AES-256), as in
         KillerNotes and Killendar. The STATIC provider (not bundle_e_sqlcipher) is deliberate:
         it binds through plain DllImport, satisfied by SqlCipherBootstrap's preload, so the
         native loads the same way in every build. The .Core ADO.NET wrapper stays managed. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.13" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlcipher" Version="2.1.11" />
    <!-- The x64 SQLCipher native itself is VENDORED (third_party\sqlcipher\e_sqlcipher.dll,
         built from upstream source - see the README there), embedded as a resource and
         self-extracted at runtime using the family loading pattern. No Condition: a
         missing crypto native must fail the build, not ship without it. -->
    <EmbeddedResource Include="third_party\sqlcipher\e_sqlcipher.dll">
      <LogicalName>KillerShot.SqlCipherNative.e_sqlcipher.dll</LogicalName>
    </EmbeddedResource>
    <Content Include="third_party\sqlcipher\LICENSE-*.txt" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated from brand\icon.png by brand\make_icon.py. Regenerate rather than hand-editing. -->
    <Resource Include="Resources\kst-icon.ico" />
    <Resource Include="Resources\app-icon-master.png" />
    <Resource Include="Resources\kst-icon.png" />
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Resources\*.cur" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK version in the target framework exposes Windows Graphics Capture for
         window mode. SupportedOSPlatformVersion keeps the Windows 11 minimum explicit. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\kst-icon.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <Authors>Steve the Killer</Authors>
    <Copyright>Copyright (c) 2026 Steve the Killer</Copyright>
    <FileVersion>0.1.0.0</FileVersion>
    <!-- Shown on the About card beside the version. Keep this as Unreleased during development. -->
    <ReleaseDate>Unreleased</ReleaseDate>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Bake ReleaseDate into the assembly so About can show it. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ReleaseDate</_Parameter1>
      <_Parameter2>$(ReleaseDate)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Generated from brand\icon.png by brand\make_icon.py. Regenerate rather than hand-editing. -->
    <Resource Include="Resources\kst-icon.ico" />
    <Resource Include="Resources\app-icon-master.png" />
    <Resource Include="Resources\kst-icon.png" />
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Resources\*.cur" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- KillerShot.PrintScreen.exe: the UI Access helper that catches Print Screen over windows run
       as administrator (Program.cs). KillerShot.exe carries it as a resource and puts it in
       Program Files\KillerShot, the only kind of place Windows grants UI Access, and only to a
       signed file. release.ps1 publishes and signs it before KillerShot.exe is built. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Compiled to native code. A UI Access process must never start the .NET host, which reads
         DOTNET_ROOT, DOTNET_STARTUP_HOOKS and the profiler variables that any program running as
         the user can set, and would load whatever code they name with UI Access rights. A native
         file has no host and no runtime to redirect. -->
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StartupHookSupport>false</StartupHookSupport>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KillerShot.PrintScreen</AssemblyName>
    <RootNamespace>KillerShot.PrintScreen</RootNamespace>
    <DefineConstants>$(DefineConstants);PRINTSCREEN_HELPER</DefineConstants>
    <ApplicationIcon>..\Resources\kst-icon.ico</ApplicationIcon>
    <Product>KillerShot</Product>
    <Description>KillerShot Print Screen helper</Description>
    <Authors>Steve the Killer</Authors>
    <Copyright>Copyright (c) 2026 Steve the Killer</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Self-tests build it with PrintScreenUiAccess=false: a UI Access file only starts from
         Program Files with a trusted signature, and a test copy has neither. -->
    <ApplicationManifest Condition="'$(PrintScreenUiAccess)' != 'false'">uiaccess.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(PrintScreenUiAccess)' == 'false'">test.manifest</ApplicationManifest>
    <!-- The native link does not count the manifest as an input, so the two variants build in
         separate folders. Sharing one let a test build reuse the UI Access link, and the reverse
         would put a test manifest in a release. -->
    <IntermediateOutputPath Condition="'$(PrintScreenUiAccess)' == 'false'">obj\test\$(Configuration)\</IntermediateOutputPath>
    <OutputPath Condition="'$(PrintScreenUiAccess)' == 'false'">bin\test\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Native\PrintScreenHook.cs" Link="PrintScreenHook.cs" />
  </ItemGroup>

  <!-- The native build finds the MSVC linker through vcvarsall.bat. The Visual Studio 18 Build
       Tools copy calls vswhere.exe by bare name, and when the Installer folder is not on PATH the
       "not recognized" error lands in the captured output and corrupts the linker path. This runs
       the same finder with that folder on PATH and hands its result to the native targets. -->
  <Target Name="FindLinkerWithInstallerOnPath" BeforeTargets="SetupOSSpecificProps" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <_PrintScreenVsInstaller>$([System.Environment]::GetFolderPath(SpecialFolder.ProgramFilesX86))\Microsoft Visual Studio\Installer</_PrintScreenVsInstaller>
      <_PrintScreenFindVcVars>$([System.IO.Path]::GetFullPath('$([System.IO.Path]::GetDirectoryName('$(IlcBuildTasksPath)'))\..\..\build\findvcvarsall.bat'))</_PrintScreenFindVcVars>
    </PropertyGroup>
    <Exec Condition="Exists('$(_PrintScreenFindVcVars)')" Command="&quot;$(_PrintScreenFindVcVars)&quot; x64 2&gt;nul"
          EnvironmentVariables="PATH=$(_PrintScreenVsInstaller)%3B$(PATH.Replace(';', '%3B'))"
          IgnoreExitCode="true" ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_FindVCVarsallOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_VCVarsAllFound" />
    </Exec>
    <PropertyGroup Condition="'$(_VCVarsAllFound)' == '0'">
      <IlcUseEnvironmentalTools>true</IlcUseEnvironmentalTools>
    </PropertyGroup>
  </Target>

</Project>

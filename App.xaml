<Application x:Class="KillerShot.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] is the live palette: ThemeManager updates this dictionary in place and paints
                     the accent overlay into it, so it must stay first and be the only palette here.
                     Dark is KillerShot's shipped default with the Teal accent applied over it by
                     ThemeManager; this must match ThemeManager's _current or the first paint
                     flashes the wrong palette. -->
                <ResourceDictionary Source="Themes/Dark.xaml"/>
                <ResourceDictionary Source="Controls/Controls.xaml"/>
                <!-- [2] English string base, always present. LocaleManager layers the chosen locale
                     at [3], so a partial translation falls back to English. -->
                <ResourceDictionary Source="Strings/en-US.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

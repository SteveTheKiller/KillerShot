<UserControl x:Class="KillerShot.Files.FilesWorkspace"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:kc="clr-namespace:KillerShot.Controls"
 xmlns:files="clr-namespace:KillerShot.Files">
 <UserControl.Resources>
  <!-- KillerShell's PaneViewButton (FilePane.xaml), for the new-tab button. -->
  <Style x:Key="PaneViewButton" TargetType="Button" BasedOn="{StaticResource ViewToggleBtn}">
   <Setter Property="FontSize" Value="16"/>
   <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <!-- Files folder tabs only. The strip is KillerShell's (Controls/FilePane.xaml): a transparent
       band on the window, transparent inactive tabs split by a fading divider, and an opaque
       active tab that joins the Files page below it. Collections are never tabs; they are
       picked from the toolbar picker and the sidebar. -->
  <Border x:Name="TabBar" Grid.Row="0" Panel.ZIndex="20" Margin="{DynamicResource TabBarMargin}"
          Height="{DynamicResource TabBandHeight}" Background="Transparent" Visibility="Collapsed"
          SizeChanged="TabBar_SizeChanged">
   <Grid>
    <Border IsHitTestVisible="False" Opacity="{DynamicResource BarShadowOpacity}" RenderTransformOrigin="0.5,0.5">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#00000000" Offset="0.45"/><GradientStop Color="#59000000" Offset="1"/>
     </LinearGradientBrush></Border.Background>
     <Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#FFFFFFFF" Offset="0.06"/>
      <GradientStop Color="#FFFFFFFF" Offset="0.94"/><GradientStop Color="#00FFFFFF" Offset="1"/>
     </LinearGradientBrush></Border.OpacityMask>
    </Border>
    <Border Height="1" VerticalAlignment="Bottom" Margin="0,0,0,1" Background="{DynamicResource RetroTabJoinLineBrush}"
            Visibility="{DynamicResource RetroTabJoinVisibility}" IsHitTestVisible="False"/>
    <DockPanel LastChildFill="True">
     <Button x:Name="NewTabButton" DockPanel.Dock="Right" Style="{StaticResource PaneViewButton}"
             Width="22" Height="20" Margin="2,4,2,3" VerticalAlignment="Center"
             ToolTip="{DynamicResource Str_TT_NewTab}" AutomationProperties.Name="{DynamicResource Str_TT_NewTab}" Click="NewTab_Click">
      <Path Width="11" Height="11" Stretch="None" IsHitTestVisible="False" SnapsToDevicePixels="True"
            UseLayoutRounding="True" RenderOptions.EdgeMode="Aliased"
            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
            Data="M5,0 H6 V5 H11 V6 H6 V11 H5 V6 H0 V5 H5 Z"/>
     </Button>
     <Button x:Name="TabOverflowButton" DockPanel.Dock="Right" Visibility="Collapsed"
             Style="{StaticResource GrungeCalendarNavButton}" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
             Foreground="{DynamicResource MutedTextBrush}" Width="22" Height="20" Margin="2,4,2,3" VerticalAlignment="Center"
             FocusVisualStyle="{x:Null}" ToolTip="{DynamicResource Str_TT_TabOverflow}"
             AutomationProperties.Name="{DynamicResource Str_TT_TabOverflow}" Click="TabOverflow_Click"/>
     <ScrollViewer x:Name="TabScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                   Background="Transparent" FocusVisualStyle="{x:Null}" HorizontalContentAlignment="Left"
                   UseLayoutRounding="True" SnapsToDevicePixels="True">
      <Grid x:Name="TabStripHost" HorizontalAlignment="Left" UseLayoutRounding="True" SnapsToDevicePixels="True">
       <ItemsControl x:Name="TabStrip" Focusable="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Style.Triggers>
         <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Panel.ZIndex" Value="1"/></DataTrigger>
         <DataTrigger Binding="{Binding IsStripVisible}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        </Style.Triggers></Style></ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
         <DataTemplate DataType="{x:Type files:FilesTab}">
          <kc:TabSurfaceBorder x:Name="tabBd" CornerRadius="0" Margin="{DynamicResource TabMargin}" Padding="{DynamicResource TabPadding}"
                  RetroBottomEdges="{DynamicResource TabRetroBottomEdges}" MinWidth="160" MaxWidth="260"
                  RenderTransform="{DynamicResource TabPlacementTransform}" RenderTransformOrigin="0.5,0.5"
                  UseLayoutRounding="True" SnapsToDevicePixels="True" Cursor="Hand" MenuBackground="Transparent"
                  ContentBackground="{DynamicResource MenuBackgroundBrush}" BorderThickness="0,0,1,0"
                  DividerBrush="{DynamicResource PaneEdgeBrush}"
                  BorderBrush="{Binding FadedDividerBrush, RelativeSource={RelativeSource Self}}"
                  Focusable="True" AutomationProperties.Name="{Binding Title}" AllowDrop="True"
                  MouseDown="Tab_MouseDown" KeyDown="Tab_KeyDown" Drop="Tab_Drop"
                  PreviewMouseLeftButtonDown="Tab_DragDown" PreviewMouseMove="Tab_DragMove">
           <Grid>
            <Border x:Name="tabGrain" IsHitTestVisible="False" CornerRadius="{Binding CornerRadius, ElementName=tabBd}"
                    Margin="{DynamicResource TabGrainMargin}" Background="{DynamicResource GrainTileBrush}" Opacity="0"/>
            <Border x:Name="tabActiveRetroOuterOutline" IsHitTestVisible="False" Panel.ZIndex="7" Margin="{DynamicResource TabActiveOuterOutlineMargin}"
                    BorderBrush="{DynamicResource TabOuterOutlineBrush}" BorderThickness="{DynamicResource TabOuterOutlineThickness}"
                    SnapsToDevicePixels="True" Visibility="Collapsed"/>
            <Border x:Name="tabInactiveRetroOuterOutline" IsHitTestVisible="False" Panel.ZIndex="7" Margin="{DynamicResource TabInactiveOuterOutlineMargin}"
                    BorderBrush="{DynamicResource TabOuterOutlineBrush}" BorderThickness="{DynamicResource TabOuterOutlineThickness}"
                    SnapsToDevicePixels="True" Visibility="Collapsed"/>
            <Border x:Name="tabBevelLight" IsHitTestVisible="False" Margin="{DynamicResource TabBevelMargin}" Panel.ZIndex="4"
                    BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource TabBevelLightThickness}"/>
            <Border x:Name="tabBevelDark" IsHitTestVisible="False" Margin="{DynamicResource TabBevelDarkMargin}" Panel.ZIndex="4"
                    BorderBrush="{DynamicResource BevelDarkBrush}" BorderThickness="{DynamicResource TabInactiveBevelDarkThickness}"/>
            <Border x:Name="tabActiveRetroInnerBevel" IsHitTestVisible="False" Panel.ZIndex="6" Margin="{DynamicResource TabActiveInnerBevelMargin}"
                    BorderBrush="{DynamicResource TabActiveInnerBevelBrush}" BorderThickness="{DynamicResource TabActiveInnerBevelThickness}"
                    SnapsToDevicePixels="True" Visibility="Collapsed"/>
            <DockPanel x:Name="tabContents" LastChildFill="True" VerticalAlignment="Center"
                       RenderTransform="{DynamicResource TabPlacementTransform}" RenderTransformOrigin="0.5,0.5">
             <Button x:Name="tabClose" DockPanel.Dock="Right" Content="x" Width="24" Height="24" Margin="{DynamicResource TabCloseMargin}"
                     FontSize="17" Padding="0" VerticalAlignment="Center" FocusVisualStyle="{x:Null}" Style="{StaticResource DangerButton}"
                     ToolTip="{DynamicResource Str_TT_CloseTab}" Tag="{Binding}" Click="CloseTab_Click"
                     AutomationProperties.Name="{Binding CloseLabel}"/>
             <Image x:Name="tabFolderIcon" DockPanel.Dock="Left" Width="{DynamicResource TabIconSize}" Height="{DynamicResource TabIconSize}"
                    Stretch="Uniform" Margin="{DynamicResource TabIconMargin}" VerticalAlignment="Center"
                    RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Icon}"/>
             <TextBlock x:Name="tabLbl" Text="{Binding Title}" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                        Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
           </Grid>
          </kc:TabSurfaceBorder>
          <DataTemplate.Triggers>
           <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
            <Setter TargetName="tabFolderIcon" Property="Visibility" Value="Collapsed"/>
           </DataTrigger>
           <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
             <Condition Binding="{Binding IsFirst}" Value="True"/>
             <Condition Binding="{Binding IsActive}" Value="False"/>
            </MultiDataTrigger.Conditions>
            <Setter TargetName="tabBd" Property="Margin" Value="{DynamicResource TabInactiveFirstMargin}"/>
           </MultiDataTrigger>
           <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
             <Condition Binding="{Binding IsLast}" Value="True"/>
             <Condition Binding="{Binding IsActive}" Value="False"/>
            </MultiDataTrigger.Conditions>
            <Setter TargetName="tabBd" Property="Margin" Value="{DynamicResource TabInactiveLastMargin}"/>
           </MultiDataTrigger>
           <DataTrigger Binding="{Binding IsActive}" Value="True">
            <Setter TargetName="tabBd" Property="CornerRadius" Value="3,3,0,0"/>
            <Setter TargetName="tabClose" Property="Style" Value="{StaticResource DangerButton}"/>
            <Setter TargetName="tabBd" Property="BlendProgress" Value="0"/>
            <Setter TargetName="tabGrain" Property="Opacity" Value="{DynamicResource GrainOpacity}"/>
            <Setter TargetName="tabBd" Property="BorderThickness" Value="{DynamicResource TabStripeThickness}"/>
            <Setter TargetName="tabBd" Property="Margin" Value="{DynamicResource TabActiveMargin}"/>
            <Setter TargetName="tabBevelLight" Property="Margin" Value="{DynamicResource TabActiveBevelLightMargin}"/>
            <Setter TargetName="tabBevelDark" Property="BorderThickness" Value="{DynamicResource TabActiveBevelDarkThickness}"/>
            <Setter TargetName="tabBevelDark" Property="Margin" Value="{DynamicResource TabActiveBevelDarkMargin}"/>
            <Setter TargetName="tabActiveRetroOuterOutline" Property="Visibility" Value="{DynamicResource RetroActiveTabOutlineVisibility}"/>
            <Setter TargetName="tabActiveRetroInnerBevel" Property="Visibility" Value="{DynamicResource RetroActiveTabOutlineVisibility}"/>
            <Setter TargetName="tabBd" Property="Padding" Value="{DynamicResource TabActivePadding}"/>
            <Setter TargetName="tabBd" Property="BorderBrush" Value="{DynamicResource TabActiveRingBrush}"/>
            <Setter TargetName="tabBd" Property="Effect" Value="{DynamicResource BarShadowEffect}"/>
            <Setter TargetName="tabLbl" Property="Foreground" Value="{DynamicResource TextBrush}"/>
           </DataTrigger>
           <DataTrigger Binding="{Binding UseRetroTabChrome}" Value="True">
            <Setter TargetName="tabBd" Property="Effect" Value="{x:Null}"/>
           </DataTrigger>
           <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
             <Condition Binding="{Binding UseRetroTabChrome}" Value="True"/>
             <Condition Binding="{Binding IsActive}" Value="True"/>
            </MultiDataTrigger.Conditions>
            <Setter TargetName="tabContents" Property="Margin" Value="0,3,0,-3"/>
           </MultiDataTrigger>
           <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
             <Condition Binding="{Binding UseRetroTabChrome}" Value="True"/>
             <Condition Binding="{Binding IsActive}" Value="False"/>
            </MultiDataTrigger.Conditions>
            <Setter TargetName="tabInactiveRetroOuterOutline" Property="Visibility" Value="Visible"/>
           </MultiDataTrigger>
           <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
             <Condition Binding="{Binding IsActive}" Value="True"/>
             <Condition Binding="{Binding IsFirst}" Value="True"/>
            </MultiDataTrigger.Conditions>
            <Setter TargetName="tabBd" Property="Margin" Value="{DynamicResource TabActiveFirstMargin}"/>
           </MultiDataTrigger>
           <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
             <Condition Binding="{Binding IsActive}" Value="True"/>
             <Condition Binding="{Binding IsLast}" Value="True"/>
            </MultiDataTrigger.Conditions>
            <Setter TargetName="tabBd" Property="Margin" Value="{DynamicResource TabActiveLastMargin}"/>
           </MultiDataTrigger>
           <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
             <Condition Binding="{Binding IsActive}" Value="True"/>
             <Condition Binding="{Binding IsFirst}" Value="True"/>
             <Condition Binding="{Binding IsLast}" Value="True"/>
            </MultiDataTrigger.Conditions>
            <Setter TargetName="tabBd" Property="Margin" Value="{DynamicResource TabActiveOnlyMargin}"/>
           </MultiDataTrigger>
           <!-- One pane, as KillerShell with a single pane: the accent sides fade into the page. -->
           <DataTrigger Binding="{Binding IsActive}" Value="True">
            <Setter TargetName="tabBd" Property="BorderThickness" Value="{DynamicResource TabFocusThickness}"/>
            <Setter TargetName="tabBd" Property="Padding" Value="{DynamicResource TabFocusPadding}"/>
            <Setter TargetName="tabBd" Property="BorderBrush" Value="{DynamicResource TabActiveRingFadeBrush}"/>
           </DataTrigger>
           <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
             <Condition Binding="{Binding UseRetroTabChrome}" Value="True"/>
             <Condition Binding="{Binding IsActive}" Value="False"/>
            </MultiDataTrigger.Conditions>
            <Setter TargetName="tabBd" Property="MenuBackground" Value="{DynamicResource TabInactiveBrush}"/>
            <Setter TargetName="tabClose" Property="RenderTransform">
             <Setter.Value><TranslateTransform Y="-2"/></Setter.Value>
            </Setter>
           </MultiDataTrigger>
           <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
             <Condition Binding="{Binding UseRetroTabChrome}" Value="True"/>
             <Condition Binding="{Binding IsActive}" Value="True"/>
            </MultiDataTrigger.Conditions>
            <Setter TargetName="tabBd" Property="MenuBackground" Value="{DynamicResource TabActiveBrush}"/>
           </MultiDataTrigger>
           <!-- The active tab wears the Files page's bar color, as KillerShell's wears its location row. -->
           <DataTrigger Binding="{Binding IsActive}" Value="True">
            <Setter TargetName="tabBd" Property="MenuBackground" Value="{DynamicResource MenuBackgroundBrush}"/>
           </DataTrigger>
          </DataTemplate.Triggers>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </Grid>
     </ScrollViewer>
    </DockPanel>
   </Grid>
  </Border>
  <Grid x:Name="Pages" Grid.Row="1"/>
  <ContentPresenter x:Name="CollectionHost" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                    Content="{Binding CollectionContent, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
 </Grid>
</UserControl>

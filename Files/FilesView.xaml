<UserControl x:Class="KillerShot.Files.FilesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:KillerShot.Controls" xmlns:files="clr-namespace:KillerShot.Files" xmlns:shellns="clr-namespace:KillerShot.Files" xmlns:models="clr-namespace:KillerShot.Files" xmlns:theme="clr-namespace:KillerFamily.Theming" UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="PaneViewButton" TargetType="Button" BasedOn="{StaticResource ViewToggleBtn}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
        </Style>
        <ItemsPanelTemplate x:Key="PanelStack">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="PanelWrap">
            <local:VirtualizingWrapPanel ItemWidth="{Binding Tag.TileWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" ItemHeight="{Binding Tag.TileHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="PanelWrapVertical">
            <local:VirtualizingWrapPanel Orientation="Vertical" ItemWidth="{Binding Tag.ListItemWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" ItemHeight="{Binding Tag.ListItemHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type files:FileEntry}">
            <Border x:Name="TileBd" CornerRadius="4" Cursor="Hand" BorderThickness="1" Margin="{Binding Tag.TileMargin, RelativeSource={RelativeSource AncestorType=ListBox}}" Padding="{Binding Tag.TilePad, RelativeSource={RelativeSource AncestorType=ListBox}}" Tag="{Binding FilePath}" ToolTip="{Binding FilePath}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectionBg}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Image HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" MaxWidth="{Binding Tag.TileSize, RelativeSource={RelativeSource AncestorType=ListBox}}" Height="{Binding Tag.TileSize, RelativeSource={RelativeSource AncestorType=ListBox}}" shellns:TileArt.Path="{Binding FilePath}" shellns:TileArt.IsDirectory="{Binding IsDirectory}" shellns:TileArt.Size="{Binding Tag.TileSize, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <TextBlock Text="{Binding NameLabel, Mode=OneWay}" Style="{StaticResource TileResultText}" FontFamily="{DynamicResource MonoFont}" FontSize="10.5" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30" Margin="{Binding Tag.TileNamePad, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CompactListRowTemplate" DataType="{x:Type files:FileEntry}">
            <Border Cursor="Hand" Tag="{Binding FilePath}" ToolTip="{Binding FilePath}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectionBg}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" Margin="4,2">
                    <Image Width="{Binding Tag.RowIconSize, RelativeSource={RelativeSource AncestorType=ListBox}}" Height="{Binding Tag.RowIconSize, RelativeSource={RelativeSource AncestorType=ListBox}}" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" shellns:TileArt.Path="{Binding FilePath}" shellns:TileArt.IsDirectory="{Binding IsDirectory}" shellns:TileArt.Size="{Binding Tag.RowIconSize, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <TextBlock Text="{Binding NameLabel, Mode=OneWay}" Style="{StaticResource ResultText}" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="DetailsRowTemplate" DataType="{x:Type files:FileEntry}">
            <Border Cursor="Hand" Tag="{Binding FilePath}" Padding="{Binding Tag.RowPad, RelativeSource={RelativeSource AncestorType=ListBox}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectionBg}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectionFg}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Tag.RowIconColumn, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <ColumnDefinition Width="{Binding Tag.NameWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <ColumnDefinition Width="{Binding Tag.LocationWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <ColumnDefinition Width="{Binding Tag.SizeWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <ColumnDefinition Width="{Binding Tag.ModifiedWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <ColumnDefinition Width="{Binding Tag.TypeWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <ColumnDefinition Width="{Binding Tag.CreatedWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Width="{Binding Tag.RowIconSize, RelativeSource={RelativeSource AncestorType=ListBox}}" Height="{Binding Tag.RowIconSize, RelativeSource={RelativeSource AncestorType=ListBox}}" shellns:TileArt.Path="{Binding FilePath}" shellns:TileArt.IsDirectory="{Binding IsDirectory}" shellns:TileArt.Size="{Binding Tag.RowIconSize, RelativeSource={RelativeSource AncestorType=ListBox}}" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Grid.Column="1" Text="{Binding NameLabel, Mode=OneWay}" Style="{StaticResource ResultText}" FontFamily="{DynamicResource MonoFont}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Folder}" Style="{StaticResource ResultDim}" FontFamily="{DynamicResource MonoFont}" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="3" Text="{Binding SizeLabel}" Style="{StaticResource ResultMuted}" FontFamily="{DynamicResource MonoFont}" FontSize="10.5" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="4" Text="{Binding ModifiedLabel}" Style="{StaticResource ResultMuted}" FontFamily="{DynamicResource MonoFont}" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="5" Text="{Binding TypeName}" Style="{StaticResource ResultMuted}" FontFamily="{DynamicResource MonoFont}" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="6" Text="{Binding CreatedLabel}" Style="{StaticResource ResultMuted}" FontFamily="{DynamicResource MonoFont}" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <local:PickerBorder x:Name="PaneFrame" Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource PaneEdgeBrush}" BorderThickness="{DynamicResource PaneEdgeSideThickness}" CornerRadius="{DynamicResource PanelCornerRadius}" Effect="{DynamicResource PaneShadowEffect}">
        <DockPanel PreviewKeyDown="Files_KeyDown">
            <!-- Shown only while it has something to say: a file operation's progress and Cancel,
                 or a result or error line. The footer already carries the item counts. -->
            <DockPanel x:Name="StatusBar" DockPanel.Dock="Bottom" LastChildFill="True" MinHeight="24" Background="{DynamicResource MenuBackgroundBrush}">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Text, ElementName=CommandStatus}" Value="" />
                                    <Condition Binding="{Binding Visibility, ElementName=CancelOperationButton}" Value="Collapsed" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <Button x:Name="CancelOperationButton" DockPanel.Dock="Right" Visibility="Collapsed" Content="{DynamicResource Str_Btn_Cancel}" Style="{StaticResource SurfaceButton}" Click="CancelOperation_Click" />
                <TextBlock x:Name="CommandStatus" FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="8,2" />
            </DockPanel>
            <!-- KillerShell's details pane (FilePane.xaml DetailsPane): docked at the bottom or on the
                 right, off by default. Files/DetailsPane.cs owns its position, size and contents. -->
            <Border x:Name="DetailsPane" DockPanel.Dock="Bottom" Height="160" Visibility="Collapsed" ClipToBounds="True" Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="{DynamicResource DetailsPaneBorderThickness}">
                <Grid>
                    <Border IsHitTestVisible="False" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}" />
                    <ScrollViewer x:Name="DetailsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="DetailsPaneContent" Margin="14,10,14,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="0" />
                                <RowDefinition Height="0" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition x:Name="DetailsPreviewCol" Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DetailsEmptyText" Grid.Column="0" Text="{DynamicResource Str_Details_Empty}" Foreground="{DynamicResource MutedTextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5" VerticalAlignment="Center" Visibility="Collapsed" />
                            <StackPanel x:Name="DetailsFieldsGrid" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="DetailsNameText" theme:Bevel.Enabled="True" Margin="0,0,0,9" FontFamily="{DynamicResource WordmarkAccentFont}" FontSize="20" FontWeight="Normal" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Str_Col_Size}" Foreground="{DynamicResource MutedTextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="10" />
                                    <TextBlock x:Name="DetailsSizeText" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="11" />
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Str_Col_Modified}" Foreground="{DynamicResource MutedTextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="10" />
                                    <TextBlock x:Name="DetailsModifiedText" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="11" />
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Str_Details_Created}" Foreground="{DynamicResource MutedTextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="10" />
                                    <TextBlock x:Name="DetailsCreatedText" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="11" />
                                </Grid>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Str_Details_Type}" Foreground="{DynamicResource MutedTextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="10" />
                                    <TextBlock x:Name="DetailsTypeText" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <StackPanel x:Name="DetailsMetadataRows" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Str_Details_Path}" Foreground="{DynamicResource MutedTextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="10" />
                                    <TextBlock x:Name="DetailsPathText" Grid.Column="1" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="11" TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                </Grid>
                            </StackPanel>
                            <Border x:Name="DetailsDivider" Grid.Column="1" Width="{DynamicResource DetailsDividerWidth}" HorizontalAlignment="Center" Margin="0,2" Background="{DynamicResource PaneBorderBrush}" />
                            <Grid x:Name="DetailsPreviewHost" Grid.Column="2">
                                <Image x:Name="DetailsPreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" SnapsToDevicePixels="True" />
                                <Image x:Name="DetailsPreviewIcon" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" SnapsToDevicePixels="True" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                    <Thumb x:Name="DetailsPaneGrip" Height="5" VerticalAlignment="Top" Panel.ZIndex="60" Cursor="SizeNS" DragDelta="DetailsPaneGrip_DragDelta" DragCompleted="DetailsPaneGrip_DragCompleted">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="Transparent">
                                    <Rectangle x:Name="hint" Height="1" VerticalAlignment="Top" Fill="{DynamicResource PaneBorderBrush}" Opacity="0" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Tag" Value="right">
                                        <Setter TargetName="hint" Property="Width" Value="1" />
                                        <Setter TargetName="hint" Property="Height" Value="Auto" />
                                        <Setter TargetName="hint" Property="HorizontalAlignment" Value="Left" />
                                        <Setter TargetName="hint" Property="VerticalAlignment" Value="Stretch" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="hint" Property="Opacity" Value="1" />
                                    </Trigger>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter TargetName="hint" Property="Opacity" Value="1" />
                                        <Setter TargetName="hint" Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Border>
            <!-- KillerShell's location row (FilePane.xaml LocationRow): back, forward, up and the
                 address on the left, the tool strip right-aligned in the same row. -->
            <Grid x:Name="MenuBars" DockPanel.Dock="Top" MinHeight="32" Background="{DynamicResource MenuBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" IsHitTestVisible="False" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}" />
                <DockPanel Grid.Column="0" LastChildFill="True" VerticalAlignment="Center">
                    <StackPanel x:Name="NavStrip" DockPanel.Dock="Left" Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center" TextOptions.TextRenderingMode="Grayscale">
                        <Button x:Name="NavBackBtn" Style="{StaticResource PaneViewButton}" ToolTip="{DynamicResource Str_TT_Back}" Click="Back_Click">
                            <Path Data="M7,1 L0,8 L7,15 M0,8 H16" Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                        </Button>
                        <Button x:Name="NavForwardBtn" Style="{StaticResource PaneViewButton}" Margin="2,0" ToolTip="{DynamicResource Str_TT_Forward}" Click="Forward_Click">
                            <Path Data="M9,1 L16,8 L9,15 M0,8 H16" Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                        </Button>
                        <Button x:Name="NavUpBtn" Style="{StaticResource PaneViewButton}" ToolTip="{DynamicResource Str_TT_Up}" Click="Up_Click">
                            <Path Data="M1,7 L8,0 L15,7 M8,0 V16" Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                        </Button>
                        <!-- KillerShell's favorite star (Bookmarks.cs): a bare glyph beside the address that
                             saves or unsaves the current folder in Places. Filled and accent when saved. -->
                        <Button x:Name="FavoriteStarBtn" Content="&#xE734;" Width="22" Height="22" Padding="0" Margin="2,0,0,0" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Cursor="Hand" ToolTip="{DynamicResource Str_TT_Favorite}" Click="FavoriteStar_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="Tag" Value="on">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <Border Padding="6,6,8,4" MinHeight="22" Background="Transparent" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- KillerShell's recents button (Recents.cs) on the right edge of the address. -->
                            <Button x:Name="RecentsBtn" Grid.Column="2" Style="{StaticResource ViewToggleBtn}" Width="20" Height="20" Padding="0" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="{DynamicResource Str_TT_Recents}" Click="Recents_Click">
                                <Image Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{x:Static files:IconCache.RecentsArt}" />
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="RecentsMenu" />
                                </Button.ContextMenu>
                            </Button>
                            <TextBlock x:Name="ScopePrefixText" Text="{DynamicResource Str_Lbl_In}" FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="ScopePathLabel" Grid.Column="1" Foreground="{DynamicResource PrimaryBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" MouseLeftButtonDown="ScopeBar_Click" />
                            <TextBox x:Name="AddressBox" AutomationProperties.Name="{DynamicResource Str_Col_Folder}" Grid.Column="1" Visibility="Collapsed" Height="22" VerticalAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource SearchFieldBrush}" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" FontFamily="{DynamicResource MonoFont}" FontSize="12" Padding="4,1" KeyDown="AddressBox_KeyDown" LostKeyboardFocus="AddressBox_LostKeyboardFocus" />
                        </Grid>
                    </Border>
                </DockPanel>
                <StackPanel x:Name="ToolStrip" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,4,8,2" TextOptions.TextRenderingMode="Grayscale">
                    <Button x:Name="ViewListBtn" Style="{StaticResource PaneViewButton}" Content="&#xE8FD;" ToolTip="{DynamicResource Str_TT_ViewList}" Tag="0" Click="View_Click" />
                    <Button x:Name="ViewIconsBtn" Style="{StaticResource PaneViewButton}" Content="&#xE80A;" Margin="2,0" ToolTip="{DynamicResource Str_TT_ViewIcons}" Tag="1" Click="View_Click" />
                    <Button x:Name="ViewDetailsBtn" Style="{StaticResource PaneViewButton}" Content="&#xE700;" Margin="0,0,2,0" ToolTip="{DynamicResource Str_TT_ViewDetails}" Tag="2" Click="View_Click" />
                    <Button x:Name="FileDensityBtn" Style="{StaticResource PaneViewButton}" Content="&#xE8A1;" Margin="0,0,2,0" ToolTip="{DynamicResource Str_TT_Density}" Click="Density_Click" PreviewMouseWheel="Density_Wheel" />
                    <!-- KillerShell's one group separator, between the view modes and the sort controls. -->
                    <Border x:Name="ViewSortSeparator" Width="{DynamicResource BarSepWidth}" Margin="2,3,4,3" Background="{DynamicResource BarSepBrush}" />
                    <ComboBox x:Name="SortBox" AutomationProperties.Name="{DynamicResource Str_TT_Sort}" ToolTip="{DynamicResource Str_TT_Sort}" Width="112" Height="24" FontSize="11" Margin="0,0,2,0" VerticalContentAlignment="Center" SelectionChanged="Sort_Changed">
                        <ComboBoxItem Tag="1" Content="{DynamicResource Str_Col_Name}" />
                        <ComboBoxItem Tag="2" Content="{DynamicResource Str_Col_Folder}" />
                        <ComboBoxItem Tag="3" Content="{DynamicResource Str_Col_Size}" />
                        <ComboBoxItem Tag="4" Content="{DynamicResource Str_Col_Modified}" />
                        <ComboBoxItem Tag="5" Content="{DynamicResource Str_Col_Type}" />
                        <ComboBoxItem Tag="6" Content="{DynamicResource Str_Col_Created}" />
                    </ComboBox>
                    <Button x:Name="SortDirectionBtn" Style="{StaticResource PaneViewButton}" Content="&#xE74A;" Margin="0,0,2,0" ToolTip="{DynamicResource Str_TT_SortDir}" Click="SortDirection_Click" />
                    <Button x:Name="ShowHiddenBtn" Style="{StaticResource PaneViewButton}" Content="&#xE7B3;" Margin="0,0,2,0" ToolTip="{DynamicResource Str_TT_ShowHidden}" Click="Hidden_Click" />
                    <Button x:Name="FoldersTopBtn" Style="{StaticResource PaneViewButton}" Content="&#xE8B7;" Margin="0,0,2,0" ToolTip="{DynamicResource Str_TT_FoldersTop}" Click="Folders_Click" />
                    <Button x:Name="ReloadBtn" Style="{StaticResource PaneViewButton}" Content="&#xE72C;" Margin="0,0,2,0" ToolTip="{DynamicResource Str_Btn_Reload}" Click="Refresh_Click" />
                    <Button x:Name="DetailsPaneBtn" Style="{StaticResource PaneViewButton}" Margin="0,0,2,0" ToolTip="{DynamicResource Str_TT_DetailsPane}" Click="DetailsPane_Click">
                        <Path x:Name="DetailsPaneGlyph" Width="15" Height="15" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Data="M0,0 H14 V14 H0 Z M2,2 L12,12" />
                    </Button>
                    <ComboBox x:Name="PlacesBox" AutomationProperties.Name="{DynamicResource Str_Col_Folder}" MinWidth="110" MaxWidth="220" Height="24" FontSize="11" Margin="4,0,0,0" VerticalContentAlignment="Center" DisplayMemberPath="Label" SelectionChanged="Place_Changed" />
                    <!-- KillerShell's export (Export.cs): one icon, the format picked from a flyout. -->
                    <Button x:Name="ExportBtn" Style="{StaticResource PaneViewButton}" Content="&#xE72D;" Margin="2,0,2,0" FontSize="15" ToolTip="{DynamicResource Str_Btn_Export}" Click="ExportButton_Click" />
                    <Popup x:Name="ExportPopup" PlacementTarget="{Binding ElementName=ExportBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-14" VerticalOffset="-2">
                        <Grid Margin="14">
                            <Grid.Resources>
                                <Style x:Key="ExportRow" TargetType="Button">
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Grid>
                                                    <Border x:Name="bg" Background="Transparent" CornerRadius="{DynamicResource SmallCornerRadius}" />
                                                    <!-- Grain over the hover fill, under the row's words, as on menu rows and card tiles. -->
                                                    <Border x:Name="ExportRowGrain" IsHitTestVisible="False" Visibility="Collapsed" CornerRadius="{DynamicResource SmallCornerRadius}" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}" />
                                                    <ContentPresenter Margin="8,4,10,4" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                                                        <Setter TargetName="ExportRowGrain" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>
                            <Border Background="{DynamicResource MenuBackgroundBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False" Opacity="{DynamicResource MenuShadowOpacity}" Effect="{DynamicResource MenuShadowEffect}" />
                            <Border Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}" Padding="6">
                                <StackPanel MinWidth="200">
                                    <Button Style="{StaticResource ExportRow}" Margin="0,0,0,2" Click="ExportCsv_Click">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="22" VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Right" Text="Ctrl+Alt+Shift+E" Foreground="{DynamicResource DimTextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="10" VerticalAlignment="Center" Margin="18,0,0,0" />
                                            <TextBlock Text="CSV" FontFamily="{DynamicResource MonoFont}" FontSize="11" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>
                                    <Button Style="{StaticResource ExportRow}" Click="ExportHtml_Click">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left" Text="&lt;&gt;" FontFamily="{DynamicResource MonoFont}" FontSize="11" FontWeight="Bold" Width="22" VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Right" Text="Ctrl+Alt+E" Foreground="{DynamicResource DimTextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="10" VerticalAlignment="Center" Margin="18,0,0,0" />
                                            <TextBlock Text="HTML" FontFamily="{DynamicResource MonoFont}" FontSize="11" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FlyoutGrain}" IsHitTestVisible="False" />
                        </Grid>
                    </Popup>
                    <!-- KillerShell's overflow (PaneToolbar.cs): collapsed until the strip sheds a tool. -->
                    <Button x:Name="OverflowBtn" Style="{StaticResource PaneViewButton}" Content="&#xE712;" Width="20" FontSize="11" Visibility="Collapsed" ToolTip="{DynamicResource Str_TT_MoreTools}" Click="Overflow_Click" />
                    <Popup x:Name="OverflowPopup" PlacementTarget="{Binding ElementName=OverflowBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-14" VerticalOffset="-2">
                        <Grid Margin="14">
                            <Border Background="{DynamicResource MenuBackgroundBrush}" CornerRadius="{DynamicResource OverflowCornerRadius}" IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="{DynamicResource OverflowShadowOpacity}" />
                                </Border.Effect>
                            </Border>
                            <Border Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource OverflowCornerRadius}" Padding="6">
                                <StackPanel x:Name="OverflowPanel" Orientation="Horizontal" />
                            </Border>
                            <Border Style="{StaticResource FlyoutGrain}" Margin="1" CornerRadius="{DynamicResource OverflowCornerRadius}" />
                        </Grid>
                    </Popup>
                </StackPanel>
            </Grid>
            <Border x:Name="DetailsHeader" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource TableHeaderBrush}" BorderBrush="{DynamicResource HeaderLineBrush}" BorderThickness="0,0,0,1" ContextMenuOpening="DetailsHeader_ContextMenuOpening">
                <Border.ContextMenu>
                    <ContextMenu Placement="Bottom" />
                </Border.ContextMenu>
                <Grid>
                    <Border IsHitTestVisible="False" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}" Margin="{Binding ViewState.HeaderPad, RelativeSource={RelativeSource AncestorType=files:FilesView}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding ViewState.RowIconColumn, RelativeSource={RelativeSource AncestorType=files:FilesView}}" />
                                <ColumnDefinition Width="{Binding ViewState.NameWidth, RelativeSource={RelativeSource AncestorType=files:FilesView}}" />
                                <ColumnDefinition Width="{Binding ViewState.LocationWidth, RelativeSource={RelativeSource AncestorType=files:FilesView}}" />
                                <ColumnDefinition Width="{Binding ViewState.SizeWidth, RelativeSource={RelativeSource AncestorType=files:FilesView}}" />
                                <ColumnDefinition Width="{Binding ViewState.ModifiedWidth, RelativeSource={RelativeSource AncestorType=files:FilesView}}" />
                                <ColumnDefinition Width="{Binding ViewState.TypeWidth, RelativeSource={RelativeSource AncestorType=files:FilesView}}" />
                                <ColumnDefinition Width="{Binding ViewState.CreatedWidth, RelativeSource={RelativeSource AncestorType=files:FilesView}}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" AutomationProperties.Name="{DynamicResource Str_Col_Name}" Style="{StaticResource ColHeaderBtn}" Click="Header_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_Col_Name}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ColNameArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Visibility="{Binding ViewState.LocationGripVisibility, RelativeSource={RelativeSource AncestorType=files:FilesView}}" AutomationProperties.Name="{DynamicResource Str_Col_Folder}" Style="{StaticResource ColHeaderBtn}" Click="Header_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_Col_Folder}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ColFolderArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Visibility="{Binding ViewState.SizeVisible, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=files:FilesView}}" AutomationProperties.Name="{DynamicResource Str_Col_Size}" Style="{StaticResource ColHeaderBtn}" HorizontalContentAlignment="Right" Click="Header_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_Col_Size}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ColSizeArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" Visibility="{Binding ViewState.ModifiedVisible, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=files:FilesView}}" AutomationProperties.Name="{DynamicResource Str_Col_Modified}" Style="{StaticResource ColHeaderBtn}" Click="Header_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_Col_Modified}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ColModifiedArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="5" Visibility="{Binding ViewState.TypeVisible, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=files:FilesView}}" AutomationProperties.Name="{DynamicResource Str_Col_Type}" Style="{StaticResource ColHeaderBtn}" Click="Header_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_Col_Type}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ColTypeArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="6" Visibility="{Binding ViewState.CreatedVisible, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=files:FilesView}}" AutomationProperties.Name="{DynamicResource Str_Col_Created}" Style="{StaticResource ColHeaderBtn}" Click="Header_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_Col_Created}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ColCreatedArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border Grid.Column="1" Tag="1" Width="6" Margin="0,0,-3,0" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" PreviewMouseLeftButtonDown="ColGrip_MouseDown" PreviewMouseMove="ColGrip_MouseMove" PreviewMouseLeftButtonUp="ColGrip_MouseUp" ToolTip="{DynamicResource Str_TT_ColResize}" />
                            <Border Grid.Column="2" Tag="2" Width="6" Margin="0,0,-3,0" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" Visibility="{Binding ViewState.LocationGripVisibility, RelativeSource={RelativeSource AncestorType=files:FilesView}}" PreviewMouseLeftButtonDown="ColGrip_MouseDown" PreviewMouseMove="ColGrip_MouseMove" PreviewMouseLeftButtonUp="ColGrip_MouseUp" ToolTip="{DynamicResource Str_TT_ColResize}" />
                            <Border Grid.Column="3" Tag="3" Width="6" Margin="0,0,-3,0" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" Visibility="{Binding ViewState.SizeGripVisibility, RelativeSource={RelativeSource AncestorType=files:FilesView}}" PreviewMouseLeftButtonDown="ColGrip_MouseDown" PreviewMouseMove="ColGrip_MouseMove" PreviewMouseLeftButtonUp="ColGrip_MouseUp" ToolTip="{DynamicResource Str_TT_ColResize}" />
                            <Border Grid.Column="4" Tag="4" Width="6" Margin="0,0,-3,0" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" Visibility="{Binding ViewState.ModifiedGripVisibility, RelativeSource={RelativeSource AncestorType=files:FilesView}}" PreviewMouseLeftButtonDown="ColGrip_MouseDown" PreviewMouseMove="ColGrip_MouseMove" PreviewMouseLeftButtonUp="ColGrip_MouseUp" ToolTip="{DynamicResource Str_TT_ColResize}" />
                            <Border Grid.Column="5" Tag="5" Width="6" Margin="0,0,-3,0" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" Visibility="{Binding ViewState.TypeGripVisibility, RelativeSource={RelativeSource AncestorType=files:FilesView}}" PreviewMouseLeftButtonDown="ColGrip_MouseDown" PreviewMouseMove="ColGrip_MouseMove" PreviewMouseLeftButtonUp="ColGrip_MouseUp" ToolTip="{DynamicResource Str_TT_ColResize}" />
                            <Border Grid.Column="6" Tag="6" Width="6" Margin="0,0,-3,0" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" Visibility="{Binding ViewState.CreatedGripVisibility, RelativeSource={RelativeSource AncestorType=files:FilesView}}" PreviewMouseLeftButtonDown="ColGrip_MouseDown" PreviewMouseMove="ColGrip_MouseMove" PreviewMouseLeftButtonUp="ColGrip_MouseUp" ToolTip="{DynamicResource Str_TT_ColResize}" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Grid>
                <Border x:Name="ResultsSurfaceGrain" IsHitTestVisible="False" CornerRadius="0" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}" />
                <Border IsHitTestVisible="False" Background="{DynamicResource ListPaneBrush}" Visibility="{Binding Visibility, ElementName=ResultsList}" />
                <Border IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=ResultsList}" BorderBrush="{DynamicResource PaneBevelDarkBrush}" BorderThickness="{DynamicResource PaneBevelLightThickness}" />
                <Border IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=ResultsList}" BorderBrush="{DynamicResource PaneBevelLightBrush}" BorderThickness="{DynamicResource PaneBevelDarkThickness}" />
                <Border IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=ResultsList}" Margin="{DynamicResource PaneBevelInnerMargin}" BorderBrush="{DynamicResource PaneBevelDark2Brush}" BorderThickness="{DynamicResource PaneBevel2LightThickness}" />
                <Border IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=ResultsList}" Margin="{DynamicResource PaneBevelInnerMargin}" BorderBrush="{DynamicResource PaneBevelLight2Brush}" BorderThickness="{DynamicResource PaneBevel2DarkThickness}" />
                <Border IsHitTestVisible="False" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}" Visibility="{Binding Visibility, ElementName=ResultsList}" />
                <ListBox x:Name="ResultsList" AutomationProperties.Name="{DynamicResource Str_Lib_ViewFiles}" Background="Transparent" BorderThickness="0" Padding="8,0,8,0" Focusable="True" SelectionMode="Extended" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextBrush}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <Canvas x:Name="InteractionLayer" ClipToBounds="True">
                    <Rectangle x:Name="MarqueeRect" Visibility="Collapsed" IsHitTestVisible="False" Stroke="{DynamicResource PrimaryBrush}" Fill="{DynamicResource SelectionBg}" Opacity="0.6" StrokeThickness="1" />
                    <TextBox x:Name="RenameBox" Visibility="Collapsed" AutomationProperties.Name="{DynamicResource Str_Fo_RenameTitle}" Background="{DynamicResource SearchFieldBrush}" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}" FontFamily="{DynamicResource UiFont}" BorderThickness="1" Padding="2,0" KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                </Canvas>
            </Grid>
        </DockPanel>
    </local:PickerBorder>
</UserControl>

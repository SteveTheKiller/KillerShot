<UserControl x:Class="KillerShot.Files.FilesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:KillerShot.Controls" xmlns:files="clr-namespace:KillerShot.Files" xmlns:shellns="clr-namespace:KillerShot.Files" xmlns:models="clr-namespace:KillerShot.Files" UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="PaneViewButton" TargetType="Button" BasedOn="{StaticResource ViewToggleBtn}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
        </Style>
        <ItemsPanelTemplate x:Key="PanelStack">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="PanelWrap">
            <local:VirtualizingWrapPanel ItemWidth="{Binding Tag.TileWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" ItemHeight="{Binding Tag.TileHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="PanelWrapVertical">
            <local:VirtualizingWrapPanel Orientation="Vertical" ItemWidth="{Binding Tag.ListItemWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" ItemHeight="{Binding Tag.ListItemHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type files:FileEntry}">
            <Border x:Name="TileBd" CornerRadius="4" Cursor="Hand" BorderThickness="1" Margin="{Binding Tag.TileMargin, RelativeSource={RelativeSource AncestorType=ListBox}}" Padding="{Binding Tag.TilePad, RelativeSource={RelativeSource AncestorType=ListBox}}" Tag="{Binding FilePath}" ToolTip="{Binding FilePath}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectionBg}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Image HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" MaxWidth="{Binding Tag.TileSize, RelativeSource={RelativeSource AncestorType=ListBox}}" Height="{Binding Tag.TileSize, RelativeSource={RelativeSource AncestorType=ListBox}}" shellns:TileArt.Path="{Binding FilePath}" shellns:TileArt.IsDirectory="{Binding IsDirectory}" shellns:TileArt.Size="{Binding Tag.TileSize, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <TextBlock Text="{Binding NameLabel, Mode=OneWay}" Style="{StaticResource TileResultText}" FontFamily="{DynamicResource MonoFont}" FontSize="10.5" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30" Margin="{Binding Tag.TileNamePad, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CompactListRowTemplate" DataType="{x:Type files:FileEntry}">
            <Border Cursor="Hand" Tag="{Binding FilePath}" ToolTip="{Binding FilePath}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectionBg}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" Margin="4,2">
                    <Image Width="{Binding Tag.RowIconSize, RelativeSource={RelativeSource AncestorType=ListBox}}" Height="{Binding Tag.RowIconSize, RelativeSource={RelativeSource AncestorType=ListBox}}" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" shellns:TileArt.Path="{Binding FilePath}" shellns:TileArt.IsDirectory="{Binding IsDirectory}" shellns:TileArt.Size="{Binding Tag.RowIconSize, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <TextBlock Text="{Binding NameLabel, Mode=OneWay}" Style="{StaticResource ResultText}" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="DetailsRowTemplate" DataType="{x:Type files:FileEntry}">
            <Border Cursor="Hand" Tag="{Binding FilePath}" Padding="{Binding Tag.RowPad, RelativeSource={RelativeSource AncestorType=ListBox}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectionBg}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectionFg}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Tag.RowIconColumn, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <ColumnDefinition Width="{Binding Tag.NameWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <ColumnDefinition Width="{Binding Tag.LocationWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <ColumnDefinition Width="{Binding Tag.SizeWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <ColumnDefinition Width="{Binding Tag.ModifiedWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <ColumnDefinition Width="{Binding Tag.TypeWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <ColumnDefinition Width="{Binding Tag.CreatedWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Width="{Binding Tag.RowIconSize, RelativeSource={RelativeSource AncestorType=ListBox}}" Height="{Binding Tag.RowIconSize, RelativeSource={RelativeSource AncestorType=ListBox}}" shellns:TileArt.Path="{Binding FilePath}" shellns:TileArt.IsDirectory="{Binding IsDirectory}" shellns:TileArt.Size="{Binding Tag.RowIconSize, RelativeSource={RelativeSource AncestorType=ListBox}}" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Grid.Column="1" Text="{Binding NameLabel, Mode=OneWay}" Style="{StaticResource ResultText}" FontFamily="{DynamicResource MonoFont}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Folder}" Style="{StaticResource ResultDim}" FontFamily="{DynamicResource MonoFont}" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="3" Text="{Binding SizeLabel}" Style="{StaticResource ResultMuted}" FontFamily="{DynamicResource MonoFont}" FontSize="10.5" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="4" Text="{Binding ModifiedLabel}" Style="{StaticResource ResultMuted}" FontFamily="{DynamicResource MonoFont}" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="5" Text="{Binding TypeName}" Style="{StaticResource ResultMuted}" FontFamily="{DynamicResource MonoFont}" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="6" Text="{Binding CreatedLabel}" Style="{StaticResource ResultMuted}" FontFamily="{DynamicResource MonoFont}" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <local:PickerBorder Margin="{DynamicResource PaneOuterMargin}" Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource PaneEdgeBrush}" BorderThickness="{DynamicResource PaneEdgeSideThickness}" CornerRadius="{DynamicResource PanelCornerRadius}" Effect="{DynamicResource PaneShadowEffect}">
        <DockPanel PreviewKeyDown="Files_KeyDown">
            <DockPanel DockPanel.Dock="Bottom" LastChildFill="True">
                <Button x:Name="CancelOperationButton" DockPanel.Dock="Right" Visibility="Collapsed" Content="{DynamicResource Str_Btn_Cancel}" Style="{StaticResource SurfaceButton}" Click="CancelOperation_Click" />
                <TextBlock x:Name="CommandStatus" FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="8,2" />
            </DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <DockPanel DockPanel.Dock="Top" LastChildFill="True" Background="{DynamicResource MenuBackgroundBrush}">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="4,0,0,0">
                        <Button x:Name="NavBackBtn" Style="{StaticResource PaneViewButton}" ToolTip="{DynamicResource Str_TT_Back}" Click="Back_Click">
                            <Path Data="M7,1 L0,8 L7,15 M0,8 H16" Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                        </Button>
                        <Button x:Name="NavForwardBtn" Style="{StaticResource PaneViewButton}" Margin="2,0" ToolTip="{DynamicResource Str_TT_Forward}" Click="Forward_Click">
                            <Path Data="M9,1 L16,8 L9,15 M0,8 H16" Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                        </Button>
                        <Button x:Name="NavUpBtn" Style="{StaticResource PaneViewButton}" ToolTip="{DynamicResource Str_TT_Up}" Click="Up_Click">
                            <Path Data="M1,7 L8,0 L15,7 M8,0 V16" Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                        </Button>
                    </StackPanel>
                    <Border Padding="6,6,8,4" MinHeight="22" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str_Lbl_In}" FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,8,0" />
                            <TextBlock x:Name="ScopePathLabel" Grid.Column="1" Foreground="{DynamicResource PrimaryBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" MouseLeftButtonDown="ScopeBar_Click" />
                            <TextBox x:Name="AddressBox" AutomationProperties.Name="{DynamicResource Str_Col_Folder}" Grid.Column="1" Visibility="Collapsed" Background="{DynamicResource SearchFieldBrush}" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" FontFamily="{DynamicResource MonoFont}" FontSize="12" Padding="4,1" KeyDown="AddressBox_KeyDown" LostKeyboardFocus="AddressBox_LostKeyboardFocus" />
                        </Grid>
                    </Border>
                </DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="4,0">
                    <Button x:Name="ViewListBtn" Style="{StaticResource PaneViewButton}" Content="" ToolTip="{DynamicResource Str_TT_ViewList}" Tag="0" Click="View_Click" />
                    <Button x:Name="ViewIconsBtn" Style="{StaticResource PaneViewButton}" Content="" Margin="2,0" ToolTip="{DynamicResource Str_TT_ViewIcons}" Tag="1" Click="View_Click" />
                    <Button x:Name="ViewDetailsBtn" Style="{StaticResource PaneViewButton}" Content="" Margin="0,0,2,0" ToolTip="{DynamicResource Str_TT_ViewDetails}" Tag="2" Click="View_Click" />
                    <Button x:Name="FileDensityBtn" Style="{StaticResource PaneViewButton}" Content="" ToolTip="{DynamicResource Str_TT_Density}" Click="Density_Click" PreviewMouseWheel="Density_Wheel" />
                    <Button x:Name="ShowHiddenBtn" Style="{StaticResource PaneViewButton}" Content="" ToolTip="{DynamicResource Str_TT_ShowHidden}" Click="Hidden_Click" />
                    <Button x:Name="FoldersTopBtn" Style="{StaticResource PaneViewButton}" Content="" ToolTip="{DynamicResource Str_TT_FoldersTop}" Click="Folders_Click" />
                    <Button Style="{StaticResource PaneViewButton}" Content="" ToolTip="{DynamicResource Str_Btn_Reload}" Click="Refresh_Click" />
                    <ComboBox x:Name="PlacesBox" AutomationProperties.Name="{DynamicResource Str_Col_Folder}" MinWidth="110" MaxWidth="220" Margin="6,0" DisplayMemberPath="Label" SelectionChanged="Place_Changed" />
                    <ComboBox x:Name="SortBox" AutomationProperties.Name="{DynamicResource Str_TT_Sort}" ToolTip="{DynamicResource Str_TT_Sort}" MinWidth="100" Margin="6,0" SelectionChanged="Sort_Changed">
                        <ComboBoxItem Tag="1" Content="{DynamicResource Str_Col_Name}" />
                        <ComboBoxItem Tag="2" Content="{DynamicResource Str_Col_Folder}" />
                        <ComboBoxItem Tag="3" Content="{DynamicResource Str_Col_Size}" />
                        <ComboBoxItem Tag="4" Content="{DynamicResource Str_Col_Modified}" />
                        <ComboBoxItem Tag="5" Content="{DynamicResource Str_Col_Type}" />
                        <ComboBoxItem Tag="6" Content="{DynamicResource Str_Col_Created}" />
                    </ComboBox>
                    <Button x:Name="SortDirectionBtn" Style="{StaticResource PaneViewButton}" Content="" ToolTip="{DynamicResource Str_TT_SortDir}" Click="SortDirection_Click" />
                </WrapPanel>
            </DockPanel>
            <Border x:Name="DetailsHeader" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource TableHeaderBrush}" BorderBrush="{DynamicResource HeaderLineBrush}" BorderThickness="0,0,0,1" MouseRightButtonUp="DetailsHeader_MouseRightButtonUp">
                <Grid>
                    <Border IsHitTestVisible="False" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}" Margin="{Binding ViewState.HeaderPad, RelativeSource={RelativeSource AncestorType=files:FilesView}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding ViewState.RowIconColumn, RelativeSource={RelativeSource AncestorType=files:FilesView}}" />
                                <ColumnDefinition Width="{Binding ViewState.NameWidth, RelativeSource={RelativeSource AncestorType=files:FilesView}}" />
                                <ColumnDefinition Width="{Binding ViewState.LocationWidth, RelativeSource={RelativeSource AncestorType=files:FilesView}}" />
                                <ColumnDefinition Width="{Binding ViewState.SizeWidth, RelativeSource={RelativeSource AncestorType=files:FilesView}}" />
                                <ColumnDefinition Width="{Binding ViewState.ModifiedWidth, RelativeSource={RelativeSource AncestorType=files:FilesView}}" />
                                <ColumnDefinition Width="{Binding ViewState.TypeWidth, RelativeSource={RelativeSource AncestorType=files:FilesView}}" />
                                <ColumnDefinition Width="{Binding ViewState.CreatedWidth, RelativeSource={RelativeSource AncestorType=files:FilesView}}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" AutomationProperties.Name="{DynamicResource Str_Col_Name}" Style="{StaticResource ColHeaderBtn}" Click="Header_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_Col_Name}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ColNameArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" AutomationProperties.Name="{DynamicResource Str_Col_Folder}" Style="{StaticResource ColHeaderBtn}" Click="Header_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_Col_Folder}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ColFolderArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" AutomationProperties.Name="{DynamicResource Str_Col_Size}" Style="{StaticResource ColHeaderBtn}" HorizontalContentAlignment="Right" Click="Header_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_Col_Size}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ColSizeArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" AutomationProperties.Name="{DynamicResource Str_Col_Modified}" Style="{StaticResource ColHeaderBtn}" Click="Header_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_Col_Modified}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ColModArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="5" AutomationProperties.Name="{DynamicResource Str_Col_Type}" Style="{StaticResource ColHeaderBtn}" Click="Header_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_Col_Type}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ColTypeArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="6" AutomationProperties.Name="{DynamicResource Str_Col_Created}" Style="{StaticResource ColHeaderBtn}" Click="Header_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_Col_Created}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ColCreatedArrow" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border Grid.Column="1" Tag="1" Width="6" Margin="0,0,-3,0" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" PreviewMouseLeftButtonDown="ColGrip_MouseDown" PreviewMouseMove="ColGrip_MouseMove" PreviewMouseLeftButtonUp="ColGrip_MouseUp" ToolTip="{DynamicResource Str_TT_ColResize}" />
                            <Border Grid.Column="2" Tag="2" Width="6" Margin="0,0,-3,0" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" Visibility="{Binding ViewState.LocationGripVisibility, RelativeSource={RelativeSource AncestorType=files:FilesView}}" PreviewMouseLeftButtonDown="ColGrip_MouseDown" PreviewMouseMove="ColGrip_MouseMove" PreviewMouseLeftButtonUp="ColGrip_MouseUp" ToolTip="{DynamicResource Str_TT_ColResize}" />
                            <Border Grid.Column="3" Tag="3" Width="6" Margin="0,0,-3,0" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" PreviewMouseLeftButtonDown="ColGrip_MouseDown" PreviewMouseMove="ColGrip_MouseMove" PreviewMouseLeftButtonUp="ColGrip_MouseUp" ToolTip="{DynamicResource Str_TT_ColResize}" />
                            <Border Grid.Column="4" Tag="4" Width="6" Margin="0,0,-3,0" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" PreviewMouseLeftButtonDown="ColGrip_MouseDown" PreviewMouseMove="ColGrip_MouseMove" PreviewMouseLeftButtonUp="ColGrip_MouseUp" ToolTip="{DynamicResource Str_TT_ColResize}" />
                            <Border Grid.Column="5" Tag="5" Width="6" Margin="0,0,-3,0" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" Visibility="{Binding ViewState.TypeGripVisibility, RelativeSource={RelativeSource AncestorType=files:FilesView}}" PreviewMouseLeftButtonDown="ColGrip_MouseDown" PreviewMouseMove="ColGrip_MouseMove" PreviewMouseLeftButtonUp="ColGrip_MouseUp" ToolTip="{DynamicResource Str_TT_ColResize}" />
                            <Border Grid.Column="6" Tag="6" Width="6" Margin="0,0,-3,0" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" Visibility="{Binding ViewState.CreatedGripVisibility, RelativeSource={RelativeSource AncestorType=files:FilesView}}" PreviewMouseLeftButtonDown="ColGrip_MouseDown" PreviewMouseMove="ColGrip_MouseMove" PreviewMouseLeftButtonUp="ColGrip_MouseUp" ToolTip="{DynamicResource Str_TT_ColResize}" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Grid>
                <Border x:Name="ResultsSurfaceGrain" IsHitTestVisible="False" CornerRadius="0" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}" />
                <Border IsHitTestVisible="False" Background="{DynamicResource ListPaneBrush}" Visibility="{Binding Visibility, ElementName=ResultsList}" />
                <Border IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=ResultsList}" BorderBrush="{DynamicResource PaneBevelDarkBrush}" BorderThickness="{DynamicResource PaneBevelLightThickness}" />
                <Border IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=ResultsList}" BorderBrush="{DynamicResource PaneBevelLightBrush}" BorderThickness="{DynamicResource PaneBevelDarkThickness}" />
                <Border IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=ResultsList}" Margin="{DynamicResource PaneBevelInnerMargin}" BorderBrush="{DynamicResource PaneBevelDark2Brush}" BorderThickness="{DynamicResource PaneBevel2LightThickness}" />
                <Border IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=ResultsList}" Margin="{DynamicResource PaneBevelInnerMargin}" BorderBrush="{DynamicResource PaneBevelLight2Brush}" BorderThickness="{DynamicResource PaneBevel2DarkThickness}" />
                <Border IsHitTestVisible="False" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}" Visibility="{Binding Visibility, ElementName=ResultsList}" />
                <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0" Padding="8,0,8,0" Focusable="True" SelectionMode="Extended" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextBrush}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <Canvas x:Name="InteractionLayer" ClipToBounds="True">
                    <Rectangle x:Name="MarqueeRect" Visibility="Collapsed" IsHitTestVisible="False" Stroke="{DynamicResource PrimaryBrush}" Fill="{DynamicResource SelectionBg}" Opacity="0.6" StrokeThickness="1" />
                    <TextBox x:Name="RenameBox" Visibility="Collapsed" AutomationProperties.Name="{DynamicResource Str_Fo_RenameTitle}" Background="{DynamicResource SearchFieldBrush}" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}" FontFamily="{DynamicResource UiFont}" BorderThickness="1" Padding="2,0" KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                </Canvas>
            </Grid>
        </DockPanel>
    </local:PickerBorder>
</UserControl>
